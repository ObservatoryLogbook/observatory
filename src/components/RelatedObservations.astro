---
import ObservationList from "./ObservationList.astro";

import {
    getObservationsForEngineering,
    getObservationsForSickBay,
} from "../lib/logbook";

interface Props {
    engineering?: "training" | "reading" | "food";

    sickBay?:
        | "body-composition"
        | "cardiovascular"
        | "sleep";
}

const {
    engineering,
    sickBay,
} = Astro.props;

const observations = engineering
    ? await getObservationsForEngineering(engineering)
    : sickBay
        ? await getObservationsForSickBay(sickBay)
        : [];
---

<!-- ===============================================================
     Related observations
     =============================================================== -->

{
    observations.length > 0 && (
        <section
            class="observations"
            aria-labelledby="related-observations"
        >
            <h2
                class="section-heading"
                id="related-observations"
            >
                Related observations
            </h2>

            <ObservationList observations={observations} />
        </section>
    )
}

<style>
    .observations {
        width: 100%;
        margin: 4.5rem 0 0;
        padding-top: 2rem;

        border-top: 1px solid var(--line-subtle);
    }
</style>