---
interface Props {
    observations: any[];
}

const { observations } = Astro.props;

const dateFormatter = new Intl.DateTimeFormat("en-GB", {
    day: "numeric",
    month: "short",
});
---

<ol class="observation-list">
    {observations.map((observation) => (
        <li>
            <a href={`/logbook/${observation.slug}`}>
                <span class="observation-number">
                    {observation.formattedNumber}
                </span>

                <time datetime={observation.data.date.toISOString()}>
                    {dateFormatter.format(observation.data.date)}
                </time>

                <span class="observation-title">
                    {observation.data.title}
                </span>
            </a>
        </li>
    ))}
</ol>

<style>
    .observation-list {
        margin: 0;
        padding: 0;

        list-style: none;
        border-top: 1px solid #deded8;
    }

    .observation-list li {
        border-bottom: 1px solid #e7e7e1;
    }

    .observation-list a {
        display: grid;
        grid-template-columns: 3rem 7rem minmax(0, 1fr);
        align-items: baseline;
        gap: 1.5rem;

        padding: 1rem 0;

        color: inherit;
        text-decoration: none;
    }

    .observation-number {
        color: #9a9d96;

        font-size: 0.8rem;
        font-weight: 300;
        line-height: 1.4;
        letter-spacing: 0.04em;
        font-variant-numeric: tabular-nums;
    }

    time {
        color: #70756c;

        font-size: 0.8rem;
        font-weight: 600;
        line-height: 1.4;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .observation-title {
        font-size: 1rem;
        line-height: 1.5;
    }

    a:hover .observation-title {
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.2em;
    }

    @media (max-width: 600px) {
        .observation-list a {
            grid-template-columns: 2.5rem 3.5rem minmax(0, 1fr);
            gap: 0.75rem;

            padding: 0.9rem 0;
        }

        .observation-number,
        time {
            font-size: 0.7rem;
        }

        .observation-title {
            font-size: 0.95rem;
        }
    }
</style>