---
interface Props {
    title: string;
    exercise: "squat" | "bench" | "deadlift";
    width?: number;
    height?: number;
}

const { title, exercise, width = 568, height = 400 } = Astro.props;
---

<div class="performance-chart-block" data-performance-chart={exercise}>
    <h4 class="performance-chart-title">{title}</h4>
    <p class="performance-chart__trend" data-chart-trend hidden></p>
    <p class="performance-chart__empty" data-chart-empty hidden>
        No training data yet.
    </p>
    <section class="performance-chart">
        <svg
            viewBox={`0 0 ${width} ${height}`}
            role="img"
            aria-label={`${title} estimated one-rep max over time`}
        ></svg>
    </section>
</div>

<style>
    .performance-chart-block [hidden] {
        display: none !important;
    }

    .performance-chart__empty {
        color: var(--text-muted);
        font-size: 0.85rem;
    }

    .performance-chart {
        width: min(100%, 36rem);
        margin: 0.5rem auto 0;
    }

    .performance-chart-title {
        margin: 1.5rem 0 0.35rem;

        font-size: 1rem;
        font-weight: 500;
    }

    svg {
        display: block;
        width: 100%;
        height: auto;
        overflow: visible;
    }

    .performance-chart :global(.axis) {
        stroke: var(--line-default);
        stroke-width: 1;
    }

    .performance-chart :global(.data-point) {
        fill: var(--page-background);
        stroke: var(--chart-data);
        stroke-width: 1.5;
    }

    .performance-chart :global(.grid-line) {
        stroke: var(--line-subtle);
        stroke-width: 1;
    }

    .performance-chart :global(.month-grid-line) {
        stroke: var(--green-surface);
        stroke-width: 1;
    }

    .performance-chart :global(.axis-label) {
        fill: var(--text-muted);
        font-size: 11px;
    }

    .performance-chart :global(.y-tick) {
        text-anchor: end;
        dominant-baseline: middle;
    }

    .performance-chart :global(.x-tick) {
        text-anchor: middle;
    }

    .performance-chart :global(.axis-title) {
        fill: var(--text-muted);
        font-size: 11px;
        text-anchor: middle;
    }

    .performance-chart__trend {
        margin: 0;

        color: var(--text-meta);
        font-size: 0.8rem;
    }

    .performance-chart :global(.trend-line) {
        stroke: var(--green-accent);
        stroke-width: 3;
        stroke-linecap: round;
        opacity: 0.8;
    }
</style>
