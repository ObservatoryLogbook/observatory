---
interface Props {
    title: string;
    description: string;
    icon: any;
}

const { title, description, icon: Icon } = Astro.props;
---

<header class="page-header">
    <div class="page-header__content">
        <h1 class="page-header__title">{title}</h1>

        <div class="page-header__divider" aria-hidden="true"></div>

        <p class="page-header__description">
            {description}
        </p>
    </div>

    <div class="page-header__icon" aria-hidden="true">
        <Icon size={64} strokeWidth={1.4} />
    </div>
</header>

<style>
    .page-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 2rem;

        width: 100%;
        max-width: none;
        box-sizing: border-box;

        margin-bottom: 4rem;
        padding: 2.5rem 2.75rem;

        background: #eef1eb;
        border: 1px solid #dde3d8;
        border-radius: 0.6rem;
    }

    .page-header__content {
        flex: 1;
        min-width: 0;
    }

    .page-header__title {
        margin: 0;

        font-size: clamp(3rem, 6vw, 4.5rem);
        line-height: 0.95;
        letter-spacing: -0.045em;
    }

    .page-header__divider {
        width: 4rem;
        height: 1px;

        margin: 1.5rem 0 1.25rem;

        background: #aab6a3;
    }

    .page-header__description {
        max-width: 58ch;
        margin: 0;

        color: #53584f;

        font-size: 1rem;
        line-height: 1.6;
    }

    .page-header__icon {
        display: flex;
        flex-shrink: 0;

        margin-top: 0.15rem;

        color: #596356;
        opacity: 0.85;
    }

    @media (max-width: 700px) {
        .page-header {
            gap: 1.5rem;
            padding: 2rem;
        }

        .page-header__title {
            font-size: clamp(2.75rem, 13vw, 4rem);
        }

        .page-header__icon :global(svg) {
            width: 3rem;
            height: 3rem;
        }
    }

    @media (max-width: 500px) {
        .page-header {
            gap: 1rem;
            padding: 1.75rem;
        }

        .page-header__title {
            font-size: clamp(2.5rem, 14vw, 3.5rem);
        }

        .page-header__icon :global(svg) {
            width: 2.5rem;
            height: 2.5rem;
        }
    }
</style>