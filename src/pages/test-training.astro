---
import { getCollection } from "astro:content";

const training = await getCollection("engineering-training");

console.log(training);
---

<p>Training entries found: {training.length}</p>

<ul>
    {training[0]?.data.goals.map((goal) => (
        <li>
            {goal.name}: {goal.target}
            {goal.type === "strength" && ` kg x ${goal.reps}`}
        </li>
    ))}
</ul>
