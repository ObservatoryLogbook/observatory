---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLatestObservations } from "../lib/logbook";
import { getActiveProjects } from "../lib/projects.ts";
import { getLatestEngineeringActivity } from "../lib/logbook";

import NotebookTabs from "@lucide/astro/icons/notebook-tabs";
import CircleGauge from "@lucide/astro/icons/circle-gauge";
import Orbit from "@lucide/astro/icons/orbit";

const entries = await getCollection("logbook");

const latestEntries = await getLatestObservations(3);
const activeProjects = await getActiveProjects();
const latestEngineeringActivity = await getLatestEngineeringActivity();
---

<BaseLayout title="Observatory">
    <main>
        <header class="page-header">
            <h1>Observatory</h1>
            <p>
                A personal collection of observations,
                projects, and data.
            </p>
        </header>

        <section
            class="observatory-grid"
            aria-label="Observatory sections"
        >
            <a
                class="observatory-card observatory-card--active"
                href="/science/"
            >
                <div class="observatory-card__header">
                    <h2>Science</h2>

                    <Orbit
                        class="observatory-card__icon"
                        aria-hidden="true"
                    />
                </div>

                <p class="observatory-card__description">
                    Long-running investigations, projects, and accumulated knowledge.
                </p>

                <div class="observatory-card__content">
                    <p class="observatory-card__label">
                        Active projects
                    </p>

                    <ul>
                        {
                            activeProjects.map((project) => (
                                <li>{project.data.title}</li>
                            ))
                        }
                    </ul>
                </div>
            </a>

            <a
                class="observatory-card observatory-card--active"
                    href="\engineering"
            >
                <div class="observatory-card__header">
                    <h2>Engineering</h2>

					<CircleGauge
					    class="observatory-card__icon"
					    aria-hidden="true"
					/>
                </div>

                <p class="observatory-card__description">
                    Build and maintain the systems that support everyday life.
                </p>

                <div class="observatory-card__content">
                    <p class="observatory-card__label">
                        Latest activity
                    </p>

                    {latestEngineeringActivity && (
                        <>
                            <p class="engineering-activity__area">
                                {
                                    latestEngineeringActivity.data.engineering?.[0]
                                }
                            </p>

                            <p class="engineering-activity__date">
                                {latestEngineeringActivity.data.date.toLocaleDateString(
                                    "en-GB",
                                    {
                                        day: "numeric",
                                        month: "short",
                                        year: "numeric",
                                    }
                                )}
                            </p>
                        </>
                    )}
                </div>
            </a>

            <a
                class="observatory-card observatory-card--active"
                href="/logbook/"
            >
                <div class="observatory-card__header">
                    <h2>Logbook</h2>

                    <NotebookTabs
                        class="observatory-card__icon"
                        aria-hidden="true"
                    />
                </div>

                <p class="observatory-card__description">
                    Observations recorded over time.
                </p>

                <div class="observatory-card__content">
                    <p class="observatory-card__label">
                        Latest observations
                    </p>

                    <ul>
                        {
                            latestEntries.map((entry) => (
                                <li>{entry.data.title}</li>
                            ))
                        }
                    </ul>
                </div>
            </a>

        </section>
    </main>
</BaseLayout>

<style>
    .engineering-activity__area {
        margin: 0;

        font-size: 1rem;
        font-weight: 500;
        text-transform: capitalize;
    }

    .engineering-activity__date {
        margin: 0.25rem 0 0;

        color: var(--text-meta);
        font-size: 0.75rem;
    }
</style>
