---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLatestObservations } from "../lib/logbook";
import { getActiveProjects } from "../lib/projects.ts";

import NotebookTabs from "@lucide/astro/icons/notebook-tabs";
import CircleGauge from "@lucide/astro/icons/circle-gauge";
import Orbit from "@lucide/astro/icons/orbit";

const entries = await getCollection("logbook");

const latestEntries = await getLatestObservations(3);
const activeProjects = await getActiveProjects();
---

<BaseLayout title="Observatory">
    <main>
        <header class="page-header">
            <h1>Observatory</h1>
            <p>
                A personal collection of observations,
                projects, and data.
            </p>
        </header>

        <section
            class="observatory-grid"
            aria-label="Observatory sections"
        >
            <a
                class="observatory-card observatory-card--active"
                href="/logbook/"
            >
                <div class="observatory-card__header">
                    <h2>Logbook</h2>

					<NotebookTabs
					    class="observatory-card__icon"
					    aria-hidden="true"
					/>
                </div>

                <p class="observatory-card__description">
                    Observations recorded over time.
                </p>

                <div class="observatory-card__content">
                    <p class="observatory-card__label">
                        Latest observations
                    </p>

                    <ul>
                        {
                            latestEntries.map((entry) => (
                                <li>{entry.data.title}</li>
                            ))
                        }
                    </ul>
                </div>
            </a>

            <a
                class="observatory-card observatory-card--active"
                href="/projects/"
            >
                <div class="observatory-card__header">
                    <h2>Science</h2>

                    <Orbit
                        class="observatory-card__icon"
                        aria-hidden="true"
                    />
                </div>

                <p class="observatory-card__description">
                    Long-running investigations, projects, and accumulated knowledge.
                </p>

                <div class="observatory-card__content">
                    <p class="observatory-card__label">
                        Active projects
                    </p>

                    <ul>
                        {
                            activeProjects.map((project) => (
                                <li>{project.data.title}</li>
                            ))
                        }
                    </ul>
                </div>
            </a>

            <article
                class="
                    observatory-card
                    observatory-card--inactive
                "
            >
                <div class="observatory-card__header">
                    <h2>Engineering</h2>

					<CircleGauge
					    class="observatory-card__icon"
					    aria-hidden="true"
					/>
                </div>

                <p class="observatory-card__description">
                    Build and maintain the systems that support everyday life.
                </p>

                <p class="observatory-card__status">
                    In development
                </p>
            </article>

        </section>
    </main>
</BaseLayout>