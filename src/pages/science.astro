---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getProjects } from "../lib/projects";
import { getObservationsForProject } from "../lib/logbook";

const projects = await getProjects();

const projectSummaries = await Promise.all(
    projects.map(async (project) => {
        const slug = project.id.replace(/\.md$/, "");
        const observations = await getObservationsForProject(slug);

        return {
            project,
            slug,
            observationCount: observations.length,
        };
    })
);

const dateFormatter = new Intl.DateTimeFormat("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
});

---

<BaseLayout title="Science">
    <main>
        <header class="landing-header">
            <h1>Science</h1>

            <p class="tagline">
                Long-running investigations, projects, and accumulated knowledge.
            </p>
        </header>

        <div class="project-grid">
            {
                projectSummaries.map(
                    ({ project, slug, observationCount }) => (
                        <a
                            class="landing-card"
                            href={`/science/${slug}`}
                        >
                            <div class="landing-card__header">
                                <h2>{project.data.title}</h2>
                            </div>

                            <p class="landing-card__description">
                                {project.data.purpose}
                            </p>

                            <dl class="project-card__meta">
                                <div>
                                    <dt>Status</dt>
                                    <dd>{project.data.status}</dd>
                                </div>

                                <div>
                                    <dt>Started</dt>
                                    <dd>{dateFormatter.format(project.data.started)}</dd>
                                </div>

                                <div>
                                    <dt>Observations</dt>
                                    <dd>{observationCount}</dd>
                                </div>
                            </dl>
                        </a>
                    )
                )
            }
        </div>
    </main>
</BaseLayout>
