---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Orbit from "@lucide/astro/icons/orbit";
import { getProjects } from "../lib/projects";
import { getObservations } from "../lib/logbook";

const projects = await getProjects();
const observations = await getObservations();

const observationCounts = new Map<string, number>();

for (const observation of observations) {
    for (const project of observation.data.projects ?? []) {
        observationCounts.set(
            project,
            (observationCounts.get(project) ?? 0) + 1
        );
    }
}

const projectSummaries = projects.map((project) => {
    const slug = project.id.replace(/\.md$/, "");

    return {
        project,
        slug,
        observationCount: observationCounts.get(slug) ?? 0,
    };
});

const dateFormatter = new Intl.DateTimeFormat("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
});
---

<BaseLayout title="Science">
    <main>
        <SectionHeader title="Science" description="Long-running investigations, projects, and accumulated knowledge." icon={Orbit} />

        <div class="project-grid">
            {
                projectSummaries.map(
                    ({ project, slug, observationCount }) => (
                        <a
                            class="landing-card"
                            href={`/science/${slug}`}
                        >
                            <div class="landing-card__header">
                                <h2>{project.data.title}</h2>
                            </div>

                            <p class="landing-card__description">
                                {project.data.purpose}
                            </p>

                            <dl class="project-card__meta">
                                <div>
                                    <dt>Status</dt>
                                    <dd>{project.data.status}</dd>
                                </div>

                                <div>
                                    <dt>Started</dt>
                                    <dd>{dateFormatter.format(project.data.started)}</dd>
                                </div>

                                <div>
                                    <dt>Observations</dt>
                                    <dd>{observationCount}</dd>
                                </div>
                            </dl>
                        </a>
                    )
                )
            }
        </div>
    </main>
</BaseLayout>
