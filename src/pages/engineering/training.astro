---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PerformanceChart from "../../components/PerformanceChart.astro";

import {
    getStrengthGoals,
    getSkillGoals,
    getLatestAchievedStrengthGoals,
    getAchievedGoals,
    getTrainingMotivation,
    getTrainingContext,
    getTrainingProgrammes,
} from "../../lib/training";

import RelatedObservations from "../../components/RelatedObservations.astro";

// -----------------------------------------------------------------------------
// Goals
// -----------------------------------------------------------------------------

const strengthGoals = await getStrengthGoals();
const skillGoals = await getSkillGoals();

// -----------------------------------------------------------------------------
// Editorial content
// -----------------------------------------------------------------------------

const motivation = await getTrainingMotivation();

const { Content: MotivationContent } =
    await motivation.render();

// -----------------------------------------------------------------------------
// Training programmes
// -----------------------------------------------------------------------------

const trainingProgrammes =
    await getTrainingProgrammes();

const renderedProgrammes = await Promise.all(
    trainingProgrammes.map(async (programme) => {
        const { Content } = await programme.render();

        return {
            ...programme,
            Content,
        };
    })
);


// -----------------------------------------------------------------------------
// Performance data
// -----------------------------------------------------------------------------

const exercises = [
    {
        key: "squat",
        name: "Squat",
        goalName: "Squat",
    },
    {
        key: "bench",
        name: "Bench press",
        goalName: "Bench press",
    },
    {
        key: "deadlift",
        name: "Deadlift",
        goalName: "Deadlift",
    },
] as const;

const performanceCards = exercises.map((exercise) => {
    const goal = strengthGoals.find(
        (goal) =>
            goal.type === "strength" &&
            goal.name === exercise.goalName
    );

    return {
        exercise: exercise.key,
        name: exercise.name,

        goal,
    };
});

// -----------------------------------------------------------------------------
// Training context
// -----------------------------------------------------------------------------

const trainingContext = await getTrainingContext();
---



<BaseLayout title="Training">
    <main class="training">

        <!-- ===============================================================
             Header
             =============================================================== -->

        <header class="training-header">
            <h1>Training</h1>

            <p class="training-header__motto">
                I can, and I will. Just keep showing up.
            </p>
        </header>

        <div class="training-tools">
            <a href="input">
                Add training
            </a>
        </div>

        <!-- ===============================================================
             Goals
             =============================================================== -->

        <section class="training-section">
            <h2 class="section-heading">Goals</h2>

            <div class="training-goals__active">
                <div class="goal-group">
                    <h3>Strength</h3>

                    <ul class="goal-list">
                        {strengthGoals.map((goal) => (
                            <li class="goal">
                                <span class="goal__name">
                                    {goal.name}
                                </span>

                                <span class="goal__target">
                                    {goal.target} {goal.unit} x {goal.reps}
                                </span>
                                {goal.targetDate && (
                                    <time
                                        class="goal__date"
                                        datetime={goal.targetDate.toISOString()}
                                    >
                                        Target{" "}
                                        {goal.targetDate.toLocaleDateString(
                                            "en-GB",
                                            {
                                                day: "numeric",
                                                month: "short",
                                                year: "numeric",
                                            }
                                        )}
                                    </time>
                                )}
                            </li>
                        ))}
                    </ul>
                </div>

                <div class="goal-group">
                    <h3>Skills</h3>

                    <ul class="goal-list">
                        {skillGoals.map((goal) => (
                            <li class="goal">
                                <span class="goal__name">
                                    {goal.name}
                                </span>

                                <span class="goal__target">
                                    {goal.target} rep
                                </span>
                                {goal.targetDate && (
                                    <time
                                        class="goal__date"
                                        datetime={goal.targetDate.toISOString()}
                                    >
                                        Target{" "}
                                        {goal.targetDate.toLocaleDateString(
                                            "en-GB",
                                            {
                                                day: "numeric",
                                                month: "short",
                                                year: "numeric",
                                            }
                                        )}
                                    </time>
                                )}
                            </li>
                        ))}
                    </ul>
                </div>
            </div>
        </section>


        <!-- ===============================================================
             Current programmes
             =============================================================== -->

        <section class="training-section">
            <h2 class="section-heading">Current programmes</h2>

            <div class="training-programmes">
                {renderedProgrammes.map((programme) => {
                    const { Content } = programme;

                    return (
                        <details class="training-programme">
                            <summary>
                                <div class="training-programme__summary">
                                    <div>
                                        <h3>{programme.data.day}</h3>

                                        <p>
                                            {programme.data.description}
                                        </p>
                                    </div>

                                    {programme.data.started && (
                                        <time
                                            datetime={
                                                programme.data.started.toISOString()
                                            }
                                        >
                                            Since{" "}
                                            {programme.data.started.toLocaleDateString(
                                                "en-GB",
                                                {
                                                    day: "numeric",
                                                    month: "short",
                                                    year: "numeric",
                                                }
                                            )}
                                        </time>
                                    )}
                                </div>

                                <span class="training-programme__toggle">
                                    View programme
                                </span>
                            </summary>

                            <div class="training-programme__content">
                                <Content />
                            </div>
                        </details>
                    );
                })}
            </div>
        </section>


        <!-- ===============================================================
             Performance
             =============================================================== -->

        <section class="training-section" id="training-performance" aria-busy="true">
            <h2 class="section-heading">Performance</h2>
            <p class="performance-status" data-performance-status role="status">
                Loading training data...
            </p>
            <noscript><p>Enable JavaScript to load training data.</p></noscript>

            <div class="performance-cards">
                {performanceCards.map((card) => (
                    <article class="performance-card" data-performance-card={card.exercise}>
                        <h3>{card.name}</h3>

                        <dl class="performance-card__metrics">
                            <div class="performance-metric">
                                <dt>Current e1RM</dt>

                                <dd>
                                    <strong data-current-e1rm>—</strong>

                                    <span>28-day best</span>
                                </dd>
                            </div>

                            <div class="performance-metric" data-pr-metric hidden>
                                <dt>1RM PR</dt>
                                <dd>
                                    <strong data-pr-weight>—</strong>
                                    <span data-pr-detail></span>
                                </dd>
                            </div>

                            {card.goal && (
                                <div class="performance-metric">
                                    <dt>Goal</dt>

                                    <dd>
                                        <strong>
                                            {card.goal.target} kg x {card.goal.reps}
                                        </strong>

                                        {card.goal.targetDate && (
                                            <span>
                                                {card.goal.targetDate.toLocaleDateString(
                                                    "en-GB",
                                                    {
                                                        day: "numeric",
                                                        month: "short",
                                                        year: "numeric",
                                                    }
                                                )}
                                            </span>
                                        )}
                                    </dd>
                                </div>
                            )}
                        </dl>
                    </article>
                ))}
            </div>

            <div class="performance-charts">
                {exercises.map((exercise) => (
                    <PerformanceChart
                        title={exercise.name}
                        exercise={exercise.key}
                    />
                ))}
            </div>
        </section>


        <!-- ===============================================================
             Motivation
             =============================================================== -->

        <section class="training-content">
            <h2 class="section-heading">Motivation</h2>
            <MotivationContent />
        </section>


        <!-- ===============================================================
             Training context
             =============================================================== -->

        <section class="training-section">
            <h2 class="section-heading">Training context</h2>

            <ul class="context-list">
                {trainingContext.map((item) => (
                    <li class="context-entry">
                        <h3>{item.title}</h3>

                        <p class="context-entry__meta">
                            Since{" "}
                            {item.affectedFrom.toLocaleDateString(
                                "en-GB",
                                {
                                    day: "numeric",
                                    month: "short",
                                    year: "numeric",
                                }
                            )}
                            {" · "}
                            {item.status}
                        </p>

                        <p>{item.notes}</p>
                    </li>
                ))}
            </ul>
        </section>

        <!-- ===============================================================
             Related observations
             =============================================================== -->

        <RelatedObservations keyword="training" />
    </main>

<script>
    import {
        getPerformanceData,
        getCurrentE1RM,
        getOneRepPR,
        getE1RMSeries,
        getTrend,
    } from "../../lib/training-data";
    import { renderPerformanceChart } from "../../lib/performance-chart";

    const initialized = new WeakSet<HTMLElement>();
    const requests = new WeakMap<HTMLElement, number>();

    async function loadPerformance(root: HTMLElement) {
        const status = root.querySelector<HTMLElement>("[data-performance-status]");
        if (!status) return;
        const request = (requests.get(root) ?? 0) + 1;
        requests.set(root, request);
        root.setAttribute("aria-busy", "true");
        status.hidden = false;
        status.textContent = "Loading training data...";

        try {
            const data = await getPerformanceData();
            if (!root.isConnected || requests.get(root) !== request) return;
            const latestDate = data.length > 0
                ? new Date(Math.max(...data.map((point) => point.date.getTime())))
                : null;

            for (const exercise of ["squat", "bench", "deadlift"] as const) {
                const card = root.querySelector<HTMLElement>(
                    `[data-performance-card="${exercise}"]`
                );
                const chart = root.querySelector<HTMLElement>(
                    `[data-performance-chart="${exercise}"]`
                );
                const current = card?.querySelector<HTMLElement>("[data-current-e1rm]");
                const prMetric = card?.querySelector<HTMLElement>("[data-pr-metric]");
                const prWeight = card?.querySelector<HTMLElement>("[data-pr-weight]");
                const prDetail = card?.querySelector<HTMLElement>("[data-pr-detail]");
                const svg = chart?.querySelector<SVGSVGElement>("svg");
                const trendLabel = chart?.querySelector<HTMLElement>("[data-chart-trend]");
                const emptyLabel = chart?.querySelector<HTMLElement>("[data-chart-empty]");
                if (!current || !prMetric || !prWeight || !prDetail ||
                    !svg || !trendLabel || !emptyLabel) {
                    throw new Error(`Performance UI is incomplete for ${exercise}.`);
                }

                const e1RM = getCurrentE1RM(data, exercise);
                current.textContent = e1RM === null
                    ? "No recent data" : `${e1RM.toFixed(1)} kg`;
                const pr = getOneRepPR(data, exercise);
                prMetric.hidden = !pr;
                if (pr) {
                    prWeight.textContent = `${pr.weight} kg`;
                    prDetail.textContent = `RPE ${pr.rpe} · ` +
                        pr.date.toLocaleDateString("en-GB", {
                            day: "numeric", month: "short", year: "numeric",
                            timeZone: "UTC",
                        });
                }

                const series = getE1RMSeries(data, exercise);
                const trend = latestDate ? getTrend(series, latestDate) : null;
                renderPerformanceChart(svg, series, trend);
                // SVG elements do not have HTMLElement.hidden.
                svg.style.display = series.length ? "" : "none";
                emptyLabel.hidden = series.length > 0;
                trendLabel.hidden = !trend;
                trendLabel.textContent = trend
                    ? `56-day trend · ${trend.change >= 0 ? "+" : ""}${trend.change.toFixed(1)} kg`
                    : "";
            }
            status.textContent = data.length ? "" : "No training data yet.";
            status.hidden = data.length > 0;
        } catch (error) {
            if (!root.isConnected || requests.get(root) !== request) return;
            console.error("Could not load training performance:", error);
            status.hidden = false;
            status.textContent = "Could not refresh training data. Reload the page to try again.";
        } finally {
            if (requests.get(root) === request) root.setAttribute("aria-busy", "false");
        }
    }

    function initializePerformance() {
        const root = document.querySelector<HTMLElement>("#training-performance");
        if (!root || initialized.has(root)) return;
        initialized.add(root);
        void loadPerformance(root);
    }

    initializePerformance();
    document.addEventListener("astro:page-load", initializePerformance);
    window.addEventListener("pageshow", (event) => {
        if (!event.persisted) return;
        const root = document.querySelector<HTMLElement>("#training-performance");
        if (root) void loadPerformance(root);
    });
</script>

</BaseLayout>




<style>
    #training-performance [hidden] {
        display: none !important;
    }

    .performance-status {
        color: var(--text-muted);
        font-size: 0.85rem;
    }

    /* ---------------------------------------------------------------------
       Page
       --------------------------------------------------------------------- */

    .training {
        width: min(100%, 52rem);
        margin: 0 auto;
    }

    .training-header__motto {
        margin: 0.75rem 0 0;

        color: var(--text-muted);
        font-size: 1rem;
        font-style: italic;
        line-height: 1.5;
    }

  .training-tools {
    display: flex;
    justify-content: flex-end;

    margin-bottom: 2rem;
  }

  .training-tools a {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

    /* ---------------------------------------------------------------------
       Typography hierarchy
       --------------------------------------------------------------------- */

    .training-section {
        margin-top: 4.5rem;
    }

    .training h3,
    .training-content :global(h3) {
        margin: 0 0 1rem;

        font-size: 1rem;
        font-weight: 500;
        line-height: 1.3;
    }

    /* ---------------------------------------------------------------------
       Goals
       --------------------------------------------------------------------- */

    .training-goals__active {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 3rem;
    }

    .goal-group h3,
    .goal-group h4 {
        margin: 0 0 1rem;

        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .goal-list {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .goal {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;

        padding: 0.8rem 0;

        border-bottom: 1px solid var(--line-subtle);
    }

    .goal__name {
        font-size: 1rem;
        font-weight: 500;
    }

    .goal__target {
        color: var(--text-muted);
        font-size: 0.9rem;
    }

    .goal__date {
        margin-top: 0.15rem;

        color: var(--text-meta);
        font-size: 0.75rem;
    }

    /* ---------------------------------------------------------------------
       Programmes
       --------------------------------------------------------------------- */

    .training-programmes {
        border-top: 1px solid var(--line-subtle);
    }

    .training-programme {
        padding: 1.25rem 0;

        border-bottom: 1px solid var(--line-subtle);
    }

    .training-programme summary {
        cursor: pointer;
        list-style: none;
    }

    .training-programme summary::-webkit-details-marker {
        display: none;
    }

    .training-programme__summary {
        display: flex;
        justify-content: space-between;
        gap: 2rem;
    }

    .training-programme__summary p {
        margin: 0.25rem 0 0;

        color: var(--text-muted);
        font-size: 0.9rem;
    }

    .training-programme__summary time {
        flex-shrink: 0;

        color: var(--text-meta);
        font-size: 0.75rem;
    }

    .training-programme__toggle {
        display: inline-block;
        margin-top: 0.75rem;

        color: var(--text-muted);
        font-size: 0.8rem;
        font-weight: 500;
    }

    .training-programme[open]
        .training-programme__toggle {
        margin-bottom: 1rem;
    }

    .training-programme__content {
        padding-top: 0.5rem;
    }

    .training-programme__content :global(p) {
        margin: 0;

        color: var(--text-muted);
        font-size: 0.85rem;
        line-height: 1.5;
    }


    /* ---------------------------------------------------------------------
       Performance
       --------------------------------------------------------------------- */

    .performance-cards {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 2rem;
    }

    .performance-card {
        min-width: 0;
    }

    .performance-card:not(:last-child) {
        padding-right: 2rem;

        border-right: 1px solid var(--line-subtle);
    }

    .performance-card__metrics {
        margin: 0;
    }

    .performance-metric {
        padding: 0.9rem 0;

        border-top: 1px solid var(--line-subtle);
    }

    .performance-metric dt {
        margin-bottom: 0.3rem;

        color: var(--text-muted);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .performance-metric dd {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;

        margin: 0;
    }

    .performance-metric strong {
        font-size: 1.15rem;
        font-weight: 500;
    }

    .performance-metric span {
        color: var(--text-meta);
        font-size: 0.75rem;
    }


    /* ---------------------------------------------------------------------
       Motivation
       --------------------------------------------------------------------- */

    .motivation-details summary {
        cursor: pointer;

        color: var(--text-muted);
        font-size: 0.9rem;
        font-weight: 500;
    }


    /* ---------------------------------------------------------------------
       Training context
       --------------------------------------------------------------------- */

    .context-list {
        margin: 0;
        padding: 0;

        list-style: none;
    }

    .context-entry {
        margin-top: 1.5rem;
    }

    .context-entry__meta {
        margin: 0.25rem 0 0.75rem;

        color: var(--text-meta);
        font-size: 0.75rem;
        text-transform: capitalize;
    }

    .context-entry > p:last-child {
        margin-bottom: 0;
    }

    /* ---------------------------------------------------------------------
       Responsive
       --------------------------------------------------------------------- */

    @media (max-width: 700px) {
        .performance-cards {
            grid-template-columns: 1fr;
            gap: 2.5rem;
        }

        .performance-card:not(:last-child) {
            padding-right: 0;
            padding-bottom: 2.5rem;

            border-right: 0;
            border-bottom: 1px solid var(--line-subtle);
        }
    }

    @media (max-width: 600px) {
        .training-goals__active,
        .training-goals__achieved-grid {
            grid-template-columns: 1fr;
            gap: 2rem;
        }
    }
</style>
