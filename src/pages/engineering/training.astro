---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PerformanceChart from "../../components/PerformanceChart.astro";

import {
    getStrengthGoals,
    getSkillGoals,
    getLatestAchievedStrengthGoals,
    getAchievedGoals,
    getTrainingSection,
    getTrainingContext,
    getTrainingProgrammes,
} from "../../lib/training";

import {
    getPerformanceData,
    getCurrentE1RM,
    getOneRepPR,
    getE1RMSeries,
    getTrend,
} from "../../lib/training-data";


// -----------------------------------------------------------------------------
// Goals
// -----------------------------------------------------------------------------

const strengthGoals = await getStrengthGoals();
const skillGoals = await getSkillGoals();

const achievedStrengthGoals =
    await getLatestAchievedStrengthGoals();

const achievedGoals = await getAchievedGoals();

const achievedSkillGoals = achievedGoals.filter(
    (goal) => goal.type === "skill"
);


// -----------------------------------------------------------------------------
// Editorial content
// -----------------------------------------------------------------------------

const motivation = await getTrainingSection("motivation");

const { Content: MotivationContent } =
    await motivation.render();


// -----------------------------------------------------------------------------
// Training programmes
// -----------------------------------------------------------------------------

const trainingProgrammes =
    await getTrainingProgrammes();

const renderedProgrammes = await Promise.all(
    trainingProgrammes.map(async (programme) => {
        const { Content } = await programme.render();

        return {
            ...programme,
            Content,
        };
    })
);


// -----------------------------------------------------------------------------
// Performance data
// -----------------------------------------------------------------------------

const performanceData = await getPerformanceData();

const latestTrainingDate = new Date(
    Math.max(
        ...performanceData.map(
            (point) => point.date.getTime()
        )
    )
);

const exercises = [
    {
        key: "squat",
        name: "Squat",
        goalName: "Squat",
    },
    {
        key: "bench",
        name: "Bench press",
        goalName: "Bench press",
    },
    {
        key: "deadlift",
        name: "Deadlift",
        goalName: "Deadlift",
    },
] as const;

const performanceCards = exercises.map((exercise) => {
    const goal = strengthGoals.find(
        (goal) =>
            goal.type === "strength" &&
            goal.name === exercise.goalName
    );

    return {
        exercise: exercise.key,
        name: exercise.name,

        currentE1RM: getCurrentE1RM(
            performanceData,
            exercise.key
        ),

        pr: getOneRepPR(
            performanceData,
            exercise.key
        ),

        goal,
    };
});

const performanceCharts = exercises.map((exercise) => {
    const data = getE1RMSeries(
        performanceData,
        exercise.key
    );

    return {
        exercise: exercise.key,
        title: exercise.name,
        data,
        trend: getTrend(
            data,
            latestTrainingDate
        ),
    };
});


// -----------------------------------------------------------------------------
// Training context
// -----------------------------------------------------------------------------

const trainingContext = await getTrainingContext();
---



<BaseLayout title="Training">
    <main class="training">

        <!-- ===============================================================
             Header
             =============================================================== -->

        <header class="training-header">
            <h1>Training</h1>

            <p class="training-header__motto">
                I can, and I will. Just keep showing up.
            </p>
        </header>


        <!-- ===============================================================
             Goals
             =============================================================== -->

        <section class="training-section">
            <h2>Goals</h2>

            <div class="training-goals__active">
                <div class="goal-group">
                    <h3>Strength</h3>

                    <ul class="goal-list">
                        {strengthGoals.map((goal) => (
                            <li class="goal">
                                <span class="goal__name">
                                    {goal.name}
                                </span>

                                <span class="goal__target">
                                    {goal.target} {goal.unit} x {goal.reps}
                                </span>
                                {goal.targetDate && (
                                    <time
                                        class="goal__date"
                                        datetime={goal.targetDate.toISOString()}
                                    >
                                        Target{" "}
                                        {goal.targetDate.toLocaleDateString(
                                            "en-GB",
                                            {
                                                day: "numeric",
                                                month: "short",
                                                year: "numeric",
                                            }
                                        )}
                                    </time>
                                )}
                            </li>
                        ))}
                    </ul>
                </div>

                <div class="goal-group">
                    <h3>Skills</h3>

                    <ul class="goal-list">
                        {skillGoals.map((goal) => (
                            <li class="goal">
                                <span class="goal__name">
                                    {goal.name}
                                </span>

                                <span class="goal__target">
                                    {goal.target} rep
                                </span>
                                {goal.targetDate && (
                                    <time
                                        class="goal__date"
                                        datetime={goal.targetDate.toISOString()}
                                    >
                                        Target{" "}
                                        {goal.targetDate.toLocaleDateString(
                                            "en-GB",
                                            {
                                                day: "numeric",
                                                month: "short",
                                                year: "numeric",
                                            }
                                        )}
                                    </time>
                                )}
                            </li>
                        ))}
                    </ul>
                </div>
            </div>
        </section>


        <!-- ===============================================================
             Current programmes
             =============================================================== -->

        <section class="training-section">
            <h2>Current programmes</h2>

            <div class="training-programmes">
                {renderedProgrammes.map((programme) => {
                    const { Content } = programme;

                    return (
                        <details class="training-programme">
                            <summary>
                                <div class="training-programme__summary">
                                    <div>
                                        <h3>{programme.data.day}</h3>

                                        <p>
                                            {programme.data.description}
                                        </p>
                                    </div>

                                    {programme.data.started && (
                                        <time
                                            datetime={
                                                programme.data.started.toISOString()
                                            }
                                        >
                                            Since{" "}
                                            {programme.data.started.toLocaleDateString(
                                                "en-GB",
                                                {
                                                    day: "numeric",
                                                    month: "short",
                                                    year: "numeric",
                                                }
                                            )}
                                        </time>
                                    )}
                                </div>

                                <span class="training-programme__toggle">
                                    View programme
                                </span>
                            </summary>

                            <div class="training-programme__content">
                                <Content />
                            </div>
                        </details>
                    );
                })}
            </div>
        </section>


        <!-- ===============================================================
             Performance
             =============================================================== -->

        <section class="training-section">
            <h2>Performance</h2>

            <div class="performance-cards">
                {performanceCards.map((card) => (
                    <article class="performance-card">
                        <h3>{card.name}</h3>

                        <dl class="performance-card__metrics">
                            <div class="performance-metric">
                                <dt>Current e1RM</dt>

                                <dd>
                                    <strong>
                                        {card.currentE1RM !== null
                                            ? `${card.currentE1RM.toFixed(1)} kg`
                                            : "No recent data"}
                                    </strong>

                                    <span>28-day best</span>
                                </dd>
                            </div>

                            {card.pr && (
                                <div class="performance-metric">
                                    <dt>1RM PR</dt>

                                    <dd>
                                        <strong>
                                            {card.pr.weight} kg
                                        </strong>

                                        <span>
                                            RPE {card.pr.rpe} ·{" "}
                                            {card.pr.date.toLocaleDateString(
                                                "en-GB",
                                                {
                                                    day: "numeric",
                                                    month: "short",
                                                    year: "numeric",
                                                }
                                            )}
                                        </span>
                                    </dd>
                                </div>
                            )}

                            {card.goal && (
                                <div class="performance-metric">
                                    <dt>Goal</dt>

                                    <dd>
                                        <strong>
                                            {card.goal.target} kg x {card.goal.reps}
                                        </strong>

                                        {card.goal.targetDate && (
                                            <span>
                                                {card.goal.targetDate.toLocaleDateString(
                                                    "en-GB",
                                                    {
                                                        day: "numeric",
                                                        month: "short",
                                                        year: "numeric",
                                                    }
                                                )}
                                            </span>
                                        )}
                                    </dd>
                                </div>
                            )}
                        </dl>
                    </article>
                ))}
            </div>

            <div class="performance-charts">
                {performanceCharts.map((chart) => (
                    <PerformanceChart
                        title={chart.title}
                        data={chart.data}
                        trend={chart.trend}
                    />
                ))}
            </div>
        </section>


        <!-- ===============================================================
             Motivation
             =============================================================== -->

        <section class="training-content">
            <MotivationContent />
        </section>


        <!-- ===============================================================
             Training context
             =============================================================== -->

        <section class="training-section">
            <h2>Training context</h2>

            <ul class="context-list">
                {trainingContext.map((item) => (
                    <li class="context-entry">
                        <h3>{item.title}</h3>

                        <p class="context-entry__meta">
                            Since{" "}
                            {item.affectedFrom.toLocaleDateString(
                                "en-GB",
                                {
                                    day: "numeric",
                                    month: "short",
                                    year: "numeric",
                                }
                            )}
                            {" · "}
                            {item.status}
                        </p>

                        <p>{item.notes}</p>
                    </li>
                ))}
            </ul>
        </section>

    </main>
</BaseLayout>




<style>
    /* ---------------------------------------------------------------------
       Page
       --------------------------------------------------------------------- */

    .training {
        width: min(100%, 52rem);
        margin: 0 auto;
    }

    .training-header__motto {
        margin: 0.75rem 0 0;

        color: #70756c;
        font-size: 1rem;
        font-style: italic;
        line-height: 1.5;
    }

    /* ---------------------------------------------------------------------
       Typography hierarchy
       --------------------------------------------------------------------- */

    .training-section {
        margin-top: 4.5rem;
    }

    .training h1 {
        margin: 0;

        font-size: 3.5rem;
        font-weight: 600;
        line-height: 1.05;
    }

    .training-section > h2,
    .training-content :global(h2) {
        margin: 0 -1rem 2rem;
        padding: 0.75rem 1rem;

        background: #edf0e8;
        border-radius: 0.3rem;

        color: #4f574a;
        font-size: 1.45rem;
        font-weight: 500;
        line-height: 1.2;
    }

    .training h3,
    .training-content :global(h3) {
        margin: 0 0 1rem;

        font-size: 1rem;
        font-weight: 500;
        line-height: 1.3;
    }

    /* ---------------------------------------------------------------------
       Goals
       --------------------------------------------------------------------- */

    .training-goals__active,
    .training-goals__achieved-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 3rem;
    }

    .goal-group h3,
    .goal-group h4 {
        margin: 0 0 1rem;

        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .goal-list {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .goal {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;

        padding: 0.8rem 0;

        border-bottom: 1px solid #e7e7e1;
    }

    .goal__name {
        font-size: 1rem;
        font-weight: 500;
    }

    .goal__target {
        color: #70756c;
        font-size: 0.9rem;
    }

    .goal__date,
    .goal--achieved time {
        margin-top: 0.15rem;

        color: #8a8e87;
        font-size: 0.75rem;
    }

    .training-goals__achieved {
        margin-top: 2rem;
        padding-top: 1rem;
    }

    /* ---------------------------------------------------------------------
       Programmes
       --------------------------------------------------------------------- */

    .training-programmes {
        border-top: 1px solid #e7e7e1;
    }

    .training-programme {
        padding: 1.25rem 0;

        border-bottom: 1px solid #e7e7e1;
    }

    .training-programme summary {
        cursor: pointer;
        list-style: none;
    }

    .training-programme summary::-webkit-details-marker {
        display: none;
    }

    .training-programme__summary {
        display: flex;
        justify-content: space-between;
        gap: 2rem;
    }

    .training-programme__summary p {
        margin: 0.25rem 0 0;

        color: #70756c;
        font-size: 0.9rem;
    }

    .training-programme__summary time {
        flex-shrink: 0;

        color: #8a8e87;
        font-size: 0.75rem;
    }

    .training-programme__toggle {
        display: inline-block;
        margin-top: 0.75rem;

        color: #70756c;
        font-size: 0.8rem;
        font-weight: 500;
    }

    .training-programme[open]
        .training-programme__toggle {
        margin-bottom: 1rem;
    }

    .training-programme__content {
        padding-top: 0.5rem;
    }

    .training-programme__content :global(p) {
        margin: 0;

        color: #70756c;
        font-size: 0.85rem;
        line-height: 1.5;
    }


    /* ---------------------------------------------------------------------
       Performance
       --------------------------------------------------------------------- */

    .performance-cards {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 2rem;
    }

    .performance-card {
        min-width: 0;
    }

    .performance-card:not(:last-child) {
        padding-right: 2rem;

        border-right: 1px solid #e7e7e1;
    }

    .performance-card__metrics {
        margin: 0;
    }

    .performance-metric {
        padding: 0.9rem 0;

        border-top: 1px solid #e7e7e1;
    }

    .performance-metric dt {
        margin-bottom: 0.3rem;

        color: #73796d;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .performance-metric dd {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;

        margin: 0;
    }

    .performance-metric strong {
        font-size: 1.15rem;
        font-weight: 500;
    }

    .performance-metric span {
        color: #8a8e87;
        font-size: 0.75rem;
    }


    /* ---------------------------------------------------------------------
       Motivation
       --------------------------------------------------------------------- */

    .motivation-details summary {
        cursor: pointer;

        color: #70756c;
        font-size: 0.9rem;
        font-weight: 500;
    }


    /* ---------------------------------------------------------------------
       Training context
       --------------------------------------------------------------------- */

    .context-list {
        margin: 0;
        padding: 0;

        list-style: none;
    }

    .context-entry {
        margin-top: 1.5rem;
    }

    .context-entry__meta {
        margin: 0.25rem 0 0.75rem;

        color: #8a8e87;
        font-size: 0.75rem;
        text-transform: capitalize;
    }

    .context-entry > p:last-child {
        margin-bottom: 0;
    }


    /* ---------------------------------------------------------------------
       Responsive
       --------------------------------------------------------------------- */

    @media (max-width: 700px) {
        .performance-cards {
            grid-template-columns: 1fr;
            gap: 2.5rem;
        }

        .performance-card:not(:last-child) {
            padding-right: 0;
            padding-bottom: 2.5rem;

            border-right: 0;
            border-bottom: 1px solid #e7e7e1;
        }
    }

    @media (max-width: 600px) {
        .training-goals__active,
        .training-goals__achieved-grid {
            grid-template-columns: 1fr;
            gap: 2rem;
        }
    }
</style>
