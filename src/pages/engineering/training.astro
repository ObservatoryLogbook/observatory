---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
    getStrengthGoals,
    getSkillGoals,
    getLatestAchievedStrengthGoals,
    getAchievedGoals,
    getTraining,
    getTrainingContext,
} from "../../lib/training";
import {
    getPerformanceData,
    getCurrentE1RM,
    getOneRepPR,
    getE1RMSeries,
    getTrend,
} from "../../lib/training-data";
import PerformanceChart from "../../components/PerformanceChart.astro";

const strengthGoals = await getStrengthGoals();
const skillGoals = await getSkillGoals();

const achievedStrengthGoals =
    await getLatestAchievedStrengthGoals();

const achievedGoals = await getAchievedGoals();

const achievedSkillGoals = achievedGoals.filter(
    (goal) => goal.type === "skill"
);

const training = await getTraining();
const { Content } = await training.render();
const trainingContext = await getTrainingContext();

const performanceData = await getPerformanceData(); 

const latestTrainingDate = new Date(
    Math.max(
        ...performanceData.map(
            (point) => point.date.getTime()
        )
    )
);

const squatSeries = getE1RMSeries(
    performanceData,
    "squat"
);

const squatTrend = getTrend(
    squatSeries,
    latestTrainingDate
);

const benchSeries = getE1RMSeries(
    performanceData,
    "bench"
);

const benchTrend = getTrend(
    benchSeries,
    latestTrainingDate
);

const deadliftSeries = getE1RMSeries(
    performanceData,
    "deadlift"
);

const deadliftTrend = getTrend(
    deadliftSeries,
    latestTrainingDate
);

const exercises = [
    {
        key: "squat",
        name: "Squat",
        goalName: "Squat",
    },
    {
        key: "bench",
        name: "Bench press",
        goalName: "Bench press",
    },
    {
        key: "deadlift",
        name: "Deadlift",
        goalName: "Deadlift",
    },
] as const;

const performanceCards = exercises.map((exercise) => {
    const goal = strengthGoals.find(
        (goal) =>
            goal.type === "strength" &&
            goal.name === exercise.goalName
    );

    return {
        exercise: exercise.key,
        name: exercise.name,
        currentE1RM: getCurrentE1RM(
            performanceData,
            exercise.key
        ),
        pr: getOneRepPR(
            performanceData,
            exercise.key
        ),
        goal,
    };
});
---

<BaseLayout title="Training">
    <main class="training">
        <header>
            <h1>Training</h1>
        </header>

        <p class="training-header__motto">
            I can, and I will. Just keep showing up.
        </p>

        <section class="training-section">
            <h2>Goals</h2>

            <div class="training-goals__active">
                <div class="goal-group">
                    <h3>Strength</h3>

                    <ul class="goal-list">
                        {strengthGoals.map((goal) => (
                            <li class="goal">
                                <span class="goal__name">
                                    {goal.name}
                                </span>

                                <span class="goal__target">
                                    {goal.target} {goal.unit} x {goal.reps}
                                </span>
                                {goal.targetDate && (
                                    <time
                                        class="goal__date"
                                        datetime={goal.targetDate.toISOString()}
                                    >
                                        Target{" "}
                                        {goal.targetDate.toLocaleDateString(
                                            "en-GB",
                                            {
                                                day: "numeric",
                                                month: "short",
                                                year: "numeric",
                                            }
                                        )}
                                    </time>
                                )}
                            </li>
                        ))}
                    </ul>
                </div>

                <div class="goal-group">
                    <h3>Skills</h3>

                    <ul class="goal-list">
                        {skillGoals.map((goal) => (
                            <li class="goal">
                                <span class="goal__name">
                                    {goal.name}
                                </span>

                                <span class="goal__target">
                                    {goal.target} rep
                                </span>
                                {goal.targetDate && (
                                    <time
                                        class="goal__date"
                                        datetime={goal.targetDate.toISOString()}
                                    >
                                        Target{" "}
                                        {goal.targetDate.toLocaleDateString(
                                            "en-GB",
                                            {
                                                day: "numeric",
                                                month: "short",
                                                year: "numeric",
                                            }
                                        )}
                                    </time>
                                )}
                            </li>
                        ))}
                    </ul>
                </div>
            </div>
        </section>



        <section class="training-section">
            <h2>Performance</h2>

            <div class="performance-cards">
                {performanceCards.map((card) => (
                    <article class="performance-card">
                        <h3>{card.name}</h3>

                        <dl class="performance-card__metrics">
                            <div class="performance-metric">
                                <dt>Current e1RM</dt>

                                <dd>
                                    <strong>
                                        {card.currentE1RM !== null
                                            ? `${card.currentE1RM.toFixed(1)} kg`
                                            : "No recent data"}
                                    </strong>

                                    <span>28-day best</span>
                                </dd>
                            </div>

                            {card.pr && (
                                <div class="performance-metric">
                                    <dt>1RM PR</dt>

                                    <dd>
                                        <strong>
                                            {card.pr.weight} kg
                                        </strong>

                                        <span>
                                            RPE {card.pr.rpe} ·{" "}
                                            {card.pr.date.toLocaleDateString(
                                                "en-GB",
                                                {
                                                    day: "numeric",
                                                    month: "short",
                                                    year: "numeric",
                                                }
                                            )}
                                        </span>
                                    </dd>
                                </div>
                            )}

                            {card.goal && (
                                <div class="performance-metric">
                                    <dt>Goal</dt>

                                    <dd>
                                        <strong>
                                            {card.goal.target} kg x {card.goal.reps}
                                        </strong>

                                        {card.goal.targetDate && (
                                            <span>
                                                {card.goal.targetDate.toLocaleDateString(
                                                    "en-GB",
                                                    {
                                                        day: "numeric",
                                                        month: "short",
                                                        year: "numeric",
                                                    }
                                                )}
                                            </span>
                                        )}
                                    </dd>
                                </div>
                            )}
                        </dl>
                    </article>
                ))}
            </div>
        </section>

        <PerformanceChart
            title="Squat"
            data={squatSeries}
            trend={squatTrend}
        />

        <PerformanceChart
            title="Bench press"
            data={benchSeries}
            trend={benchTrend}
        />

        <PerformanceChart
            title="Deadlift"
            data={deadliftSeries}
            trend={deadliftTrend}
        />

        <section class="training-content">
            <Content />
        </section>

        <section class="training-section">
            <h2>Training context</h2>

            <ul class="context-list">
                {trainingContext.map((item) => (
                    <li class="context-entry">
                        <h3>{item.title}</h3>

                        <p class="context-entry__meta">
                            Since{" "}
                            {item.affectedFrom.toLocaleDateString(
                                "en-GB",
                                {
                                    day: "numeric",
                                    month: "short",
                                    year: "numeric",
                                }
                            )}
                            {" · "}
                            {item.status}
                        </p>

                        <p>{item.notes}</p>
                    </li>
                ))}
            </ul>
        </section>

    </main>
</BaseLayout>

<style>
    .training {
        width: min(100%, 52rem);
        margin: 0 auto;
    }

    .training-section {
        margin-top: 4.5rem;
        padding-top: 1.5rem;

        border-top: 1px solid #deded8;
    }

    .training-section > h2 {
        margin: 0 0 2rem;

        font-size: 1.45rem;
        font-weight: 500;
        line-height: 1.2;
    }

    .training-header__motto {
        margin: 0.75rem 0 0;

        color: #70756c;

        font-size: 1rem;
        font-style: italic;
        line-height: 1.5;
    }

    .training-content :global(h2) {
        margin: 4.5rem 0 2rem;
        padding-top: 1.5rem;

        border-top: 1px solid #deded8;

        font-size: 1.45rem;
        font-weight: 500;
        line-height: 1.2;
    }

    .training-goals {
        margin-top: 3rem;
    }

    .training-goals > h2 {
        margin-bottom: 1.5rem;
    }

    .training-goals__active,
    .training-goals__achieved-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 3rem;
    }

    .goal-group h3,
    .goal-group h4 {
        margin: 0 0 1rem;

        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .goal-list {
        margin: 0;
        padding: 0;

        list-style: none;
    }

    .goal {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;

        padding: 0.8rem 0;

        border-bottom: 1px solid #e7e7e1;
    }

    .goal__name {
        font-size: 1rem;
        font-weight: 500;
    }

    .goal__target {
        color: #70756c;

        font-size: 0.9rem;
    }

    .goal__date {
        margin-top: 0.15rem;

        color: #8a8e87;

        font-size: 0.75rem;
    }

    .training-goals__achieved {
        margin-top: 2rem;
        padding-top: 1rem;
    }

    .performance-cards {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 2rem;
    }

    .performance-card {
        min-width: 0;
    }

    .performance-card:not(:last-child) {
        padding-right: 2rem;

        border-right: 1px solid #e7e7e1;
    }

    .performance-card h3 {
        margin: 0 0 1.5rem;

        font-size: 1rem;
        font-weight: 600;
    }

    .performance-card__metrics {
        margin: 0;
    }

    .performance-metric {
        padding: 0.9rem 0;

        border-top: 1px solid #e7e7e1;
    }

    .performance-metric dt {
        margin-bottom: 0.3rem;

        color: #73796d;

        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .performance-metric dd {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;

        margin: 0;
    }

    .performance-metric strong {
        font-size: 1.15rem;
        font-weight: 500;
    }

    .performance-metric span {
        color: #8a8e87;

        font-size: 0.75rem;
    }

    @media (max-width: 700px) {
        .performance-cards {
            grid-template-columns: 1fr;
            gap: 2.5rem;
        }

        .performance-card:not(:last-child) {
            padding-right: 0;
            padding-bottom: 2.5rem;

            border-right: 0;
            border-bottom: 1px solid #e7e7e1;
        }
    }

    .training-goals__achieved > h3 {
        margin: 0 0 1rem;

        font-size: 1.1rem;
        font-weight: 500;
    }

    .goal--achieved time {
        margin-top: 0.25rem;

        color: #8a8e87;

        font-size: 0.75rem;
    }

    .training-focus {
        margin-top: 4rem;
    }

    .motivation-details summary {
        cursor: pointer;
        color: #70756c;
        font-size: 0.9rem;
        font-weight: 500;
    }

    .training-context {
        margin-top: 4rem;
    }

    .context-list {
        margin: 0;
        padding: 0;

        list-style: none;
    }

    .context-entry {
        margin-top: 1.5rem;
    }

    .context-entry h3 {
        margin: 0;

        font-size: 1rem;
        font-weight: 500;
    }

    .context-entry__meta {
        margin: 0.25rem 0 0.75rem;

        color: #8a8e87;

        font-size: 0.75rem;
        text-transform: capitalize;
    }

    .context-entry > p:last-child {
        margin-bottom: 0;
    }

    @media (max-width: 600px) {
        .training-goals__active,
        .training-goals__achieved-grid {
            grid-template-columns: 1fr;
            gap: 2rem;
        }
    }
</style>

