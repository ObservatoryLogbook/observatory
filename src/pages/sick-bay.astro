---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Sick Bay">
  <main class="sick-bay">
    <header class="sick-bay-header">
      <h1>Sick Bay</h1>

<!--- ----- Log-in, logout ----- --->  

      <p class="sick-bay-header__intro">
        Body composition and health trends.
      </p>
    </header>

    <div class="auth-status-row">
      <p
        id="auth-status"
        aria-live="polite"
      >
        Checking authentication...
      </p>

      <button
        id="logout-button"
        type="button"
        hidden
      >
        Log out
      </button>
    </div>

    <form
      id="login-form"
      hidden
    >
      <label>
        Email
        <input
          id="email"
          type="email"
          autocomplete="email"
          required
        />
      </label>

      <label>
        Password
        <input
          id="password"
          type="password"
          autocomplete="current-password"
          required
        />
      </label>

      <button type="submit">
        Log in
      </button>
    </form>

    <section
      id="sick-bay-content"
      hidden
    >
      <div class="sick-bay-tools">
        <a
          id="input-link"
          href="/sick-bay/input"
          hidden
        >
          Add measurements
        </a>
      </div>

<!--- ----- Current status ----- --->  

      <section class="sick-bay-section">
        <h2>Current status</h2>

        <div class="current-metrics">
          <div class="current-metric">
            <p class="current-metric__label">
              Weight
            </p>

            <p
              id="current-weight"
              class="current-metric__value"
            >
              —
            </p>

            <p
              id="current-weight-meta"
              class="current-metric__meta"
            >
              7-day average
            </p>

            <div class="current-metric__trend">
              <p
                id="current-weight-trend"
                class="current-metric__trend-value"
              >
                —
              </p>

              <p class="current-metric__trend-label">
                12-week trend
              </p>
            </div>
          </div>

          <div class="current-metric">
            <p class="current-metric__label">
              Fat mass
            </p>

            <p
              id="current-fat-mass"
              class="current-metric__value"
            >
              —
            </p>

            <p
              id="current-fat-mass-meta"
              class="current-metric__meta"
            >
              7-day average
            </p>

            <div class="current-metric__trend">
              <p
                id="current-fat-mass-trend"
                class="current-metric__trend-value"
              >
                —
              </p>

              <p class="current-metric__trend-label">
                12-week trend
              </p>
            </div>
          </div>

          <div class="current-metric">
            <p class="current-metric__label">
              Muscle mass
            </p>

            <p
              id="current-muscle-mass"
              class="current-metric__value"
            >
              —
            </p>

            <p
              id="current-muscle-mass-meta"
              class="current-metric__meta"
            >
              7-day average
            </p>

            <div class="current-metric__trend">
              <p
                id="current-muscle-mass-trend"
                class="current-metric__trend-value"
              >
                —
              </p>

              <p class="current-metric__trend-label">
                12-week trend
              </p>
            </div>
          </div>

            <div class="current-metric">
              <p class="current-metric__label">
                Waist
              </p>

              <p
                id="current-waist"
                class="current-metric__value"
              >
                —
              </p>

              <p
                id="current-waist-meta"
                class="current-metric__meta"
              >
                Latest measurement
              </p>

              <div class="current-metric__trend">
                <p
                  id="current-waist-trend"
                  class="current-metric__trend-value"
                >
                  —
                </p>

                <p class="current-metric__trend-label">
                  12-week trend
                </p>
              </div>
            </div>

            <div class="current-metric">
              <p class="current-metric__label">
                Form index
              </p>

              <p
                id="current-form-index"
                class="current-metric__value"
              >
                —
              </p>

              <p
                id="current-form-index-meta"
                class="current-metric__meta"
              >
                Latest measurement
              </p>

              <div class="current-metric__trend">
                <p
                  id="current-form-index-trend"
                  class="current-metric__trend-value"
                >
                  —
                </p>

                <p class="current-metric__trend-label">
                  12-week trend
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

<!--- ----- History ----- --->  

      <section class="sick-bay-section">
        <h2>History</h2>

        <div class="history-section weight-history">
          <h3>Body composition</h3>

          <p class="weight-history__meta">
            Last 365 days
          </p>

          <div class="weight-history-chart">
            <svg
              id="weight-history-chart"
              viewBox="0 0 568 600"
              role="img"
              aria-label="Weight over the last 365 days"
            ></svg>
          </div>
        </div>

        <div class="history-section circumference-history">
          <h3>Circumferences</h3>

          <p class="circumference-history__meta">
            Last 365 days
          </p>

          <div class="circumference-history-chart">
            <svg
              id="circumference-history-chart"
              viewBox="0 0 568 440"
              role="img"
              aria-label="Circumferences over the last 365 days"
            ></svg>
          </div>
        </div>
      </section>
    </section>

<!--- ----- Segmental analysis ----- --->  

    <div class="history-section inbody-history">
      <h3>InBody</h3>

      <p class="inbody-history__meta">
        Segmental lean analysis
      </p>

      <div class="inbody-history-chart">
        <svg
          id="inbody-lean-chart"
          viewBox="0 0 568 520"
          role="img"
          aria-label="Segmental lean mass over time"
        ></svg>
      </div>

      <p class="inbody-history__meta">
        Segmental fat analysis
      </p>

      <div class="inbody-history-chart">
        <svg
          id="inbody-fat-chart"
          viewBox="0 0 568 520"
          role="img"
          aria-label="Segmental fat mass over time"
        ></svg>
      </div>
    </div>


<!--- ----- Methodology ----- --->  

    <section class="methodology">
      <details>
        <summary>Methodology</summary>

        <div class="methodology__content">
          <div>
            <h3>Measurements</h3>

            <p>
              <strong>Body composition:</strong>
              Omron KaradaScan BF511, measured daily in the morning
            </p>

            <p>
              <strong>Circumferences:</strong>
              measured weekly, usually Sunday morning
            </p>

            <p>
              <strong>Blood pressure:</strong>
              Microlife Gentle+, three consecutive measurements weekly,
              usually Sunday morning
            </p>

            <p>
              <strong>InBody:</strong>
              InBody 270, measured approximately monthly
            </p>
          </div>

          <div>
            <h3>Derived metrics</h3>

            <p>
              <strong>Fat mass</strong> = weight × body fat percentage
            </p>

            <p>
              <strong>Muscle mass</strong> = weight × skeletal muscle percentage
            </p>

            <p>
              <strong>Form index</strong> = (shoulders + chest) / (waist + hips)
            </p>
          </div>

          <div>
            <h3>Trends and smoothing</h3>

            <p>
              <strong>Body composition:</strong>
              7-day rolling average
            </p>

            <p>
              <strong>Circumferences:</strong>
              centered 3-measurement average
            </p>

            <p>
              <strong>12-week trend:</strong>
              linear regression over all observations in the latest
              84 calendar days
            </p>

            <p>
              Circumference lines break when consecutive observations
              are more than 14 days apart
            </p>
          </div>
        </div>
      </details>
    </section>
  </main>

  <script>
    import { supabase } from "../lib/sick-bay/supabase";

    import {
      getSession,
      signIn,
      signOut,
      canReadDomain,
      canWriteDomain,
    } from "../lib/sick-bay/auth";

    import {
      getRolling7DayAverage,
      getHistoryStartDate,
      getWeightTrend,
      renderBodyCompositionChart,
      type WeightObservation,
      type RollingAveragePoint,
      type WeightTrend,
    } from "../lib/sick-bay/body-composition";

    import {
      getFormIndex,
      getCircumferenceTrend,
      renderCircumferenceChart,
      type CircumferenceTrend,
      type CircumferenceObservation,
      type FormIndexObservation,
    } from "../lib/sick-bay/circumferences";

    import {
      renderSegmentalLeanChart,
      renderSegmentalFatChart,
      type SegmentalObservation,
    } from "../lib/sick-bay/inbody";

    const loginForm =
      document.querySelector<HTMLFormElement>(
        "#login-form"
      );

    const authStatus =
      document.querySelector<HTMLParagraphElement>(
        "#auth-status"
      );

    const logoutButton =
      document.querySelector<HTMLButtonElement>(
        "#logout-button"
      );

    const sickBayContent =
      document.querySelector<HTMLElement>(
        "#sick-bay-content"
      );

    const inputLink =
      document.querySelector<HTMLAnchorElement>(
        "#input-link"
      );

    if (
      !loginForm ||
      !authStatus ||
      !logoutButton ||
      !sickBayContent ||
      !inputLink
    ) {
      throw new Error(
        "Sick Bay UI could not be initialized."
      );
    }

    async function checkReadAccess() {
      sickBayContent.hidden = true;
      inputLink.hidden = true;
      logoutButton.hidden = true;

      const {
        data: sessionData,
        error: sessionError,
      } = await getSession();

      if (sessionError) {
        authStatus.textContent =
          `Could not check authentication: ${sessionError.message}`;

        loginForm.hidden = false;
        return;
      }

      if (!sessionData.session) {
        authStatus.textContent =
          "Not authenticated.";

        loginForm.hidden = false;
        return;
      }

      loginForm.hidden = true;
      logoutButton.hidden = false; 

      const {
        data: canRead,
        error: readError,
      } = await canReadDomain("body");

      if (readError) {
        authStatus.textContent =
          `Could not check read access: ${readError.message}`;

        return;
      }

      if (!canRead) {
        authStatus.textContent =
          "Authenticated, but you do not have access to Sick Bay.";

        return;
      }

      authStatus.textContent =
        "Authenticated · read access ✓";

      sickBayContent.hidden = false;

      const {
        data: weightData,
        error: weightError,
      } = await supabase
        .from("body_measurements")
        .select("measured_on, weight_kg, body_fat_pct, muscle_pct")
        .eq("source", "karada")
        .not("weight_kg", "is", null)
        .order("measured_on", { ascending: true });

      if (weightError) {
        authStatus.textContent =
          `Could not load weight data: ${weightError.message}`;

        return;
      }

      const {
        data: circumferenceData,
        error: circumferenceError,
      } = await supabase
        .from("circumferences")
        .select(
          "measured_on, shoulders_cm, chest_cm, waist_cm, hips_cm, left_upper_arm_cm, left_thigh_cm"
        )
        .order("measured_on", { ascending: true });

      if (circumferenceError) {
        authStatus.textContent =
          `Could not load circumference data: ${circumferenceError.message}`;

        return;
      }

      const {
        data: segmentalData,
        error: segmentalError,
      } = await supabase
        .from("inbody_segmental_analysis")
        .select(`
          measured_on,

          right_arm_lean_kg,
          left_arm_lean_kg,
          trunk_lean_kg,
          right_leg_lean_kg,
          left_leg_lean_kg,

          right_arm_fat_kg,
          left_arm_fat_kg,
          trunk_fat_kg,
          right_leg_fat_kg,
          left_leg_fat_kg
        `)
        .order("measured_on", { ascending: true });

      const fatMassData: WeightObservation[] =
        weightData.map((observation) => ({
          ...observation,
          weight_kg:
            observation.weight_kg *
            observation.body_fat_pct /
            100,
        }));

      const muscleMassData: WeightObservation[] =
        weightData.map((observation) => ({
          ...observation,
          weight_kg:
            observation.weight_kg *
            observation.muscle_pct /
            100,
        }));

      const formIndexData =
        circumferenceData.map(
          (observation) => ({
            measured_on:
              observation.measured_on,
            value:
              getFormIndex(observation),
          })
        );

      const waistData =
        circumferenceData.map(
          (observation) => ({
            measured_on:
              observation.measured_on,
            value:
              observation.waist_cm,
          })
        );

      const waistTrend =
        getCircumferenceTrend(
          waistData
        );

      const formIndexTrend =
        getCircumferenceTrend(
          formIndexData
        );

      const latestCircumference =
        circumferenceData.at(-1);

      const latestFormIndex =
        formIndexData.at(-1);

      const rollingWeight =
        getRolling7DayAverage(weightData);

      const rollingFatMass =
        getRolling7DayAverage(fatMassData);

      const fatMassTrend =
        getWeightTrend(fatMassData);

      const rollingMuscleMass =
        getRolling7DayAverage(muscleMassData);

      const muscleMassTrend =
        getWeightTrend(muscleMassData);

      const historyStartDate =
        getHistoryStartDate(365);

      const weightHistory =
        weightData.filter(
          (observation) =>
            observation.measured_on >=
            historyStartDate
        );

      const rollingWeightHistory =
        rollingWeight.filter(
          (point) =>
            point.date >= historyStartDate
        );

      const muscleMassHistory =
        muscleMassData.filter(
          (observation) =>
            observation.measured_on >=
            historyStartDate
        );

      const rollingMuscleMassHistory =
        rollingMuscleMass.filter(
          (point) =>
            point.date >= historyStartDate
        );

      const fatMassHistory =
        fatMassData.filter(
          (observation) =>
            observation.measured_on >=
            historyStartDate
        );

      const rollingFatMassHistory =
        rollingFatMass.filter(
          (point) =>
            point.date >= historyStartDate
        );

      const waistHistory =
        waistData.filter(
          (observation) =>
            observation.measured_on >=
            historyStartDate
        );

      const formIndexHistory =
        formIndexData.filter(
          (observation) =>
            observation.measured_on >=
            historyStartDate
        );

      function renderTrend(
        slope: number,
        element: HTMLElement,
        decimals: number,
        unit: string
      ) {
        const direction =
          slope > 0
            ? "up"
            : slope < 0
              ? "down"
              : "flat";

        const sign =
          slope > 0
            ? "+"
            : "";

        const icon =
          direction === "up"
            ? `
              <svg
                class="trend-icon"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="m18 15-6-6-6 6" />
              </svg>
            `
            : direction === "down"
              ? `
                <svg
                  class="trend-icon"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              `
              : `
                <svg
                  class="trend-icon"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="M5 12h14" />
                </svg>
              `;

        element.innerHTML =
          `${icon}<span>${sign}${slope.toFixed(decimals)}${unit}/week</span>`;
      }

      function renderCurrentMetric(
        point: RollingAveragePoint | undefined,
        trend: WeightTrend | null,
        valueElement: HTMLElement,
        metaElement: HTMLElement,
        trendElement: HTMLElement
      ) {
        if (
          !point ||
          point.mean === null
        ) {
          valueElement.textContent = "—";
          metaElement.textContent = "No recent data";
        } else {
          valueElement.textContent =
            `${point.mean.toFixed(1)} kg`;

          if (point.n >= 3) {
            metaElement.textContent =
              "7-day average";
          } else {
            metaElement.textContent =
              `7-day average · based on ${point.n} ` +
              `${point.n === 1 ? "measurement" : "measurements"}`;
          }
        }

        if (!trend) {
          trendElement.textContent = "—";
          return;
        }

        renderTrend(
          trend.slopeKgPerWeek,
          trendElement,
          2,
          " kg"
        );
      }

      renderBodyCompositionChart(
        weightHistory,
        rollingWeightHistory,
        muscleMassHistory,
        rollingMuscleMassHistory,
        fatMassHistory,
        rollingFatMassHistory,
        historyStartDate
      );

      const weightTrend =
        getWeightTrend(weightData);

      const currentWeight =
        rollingWeight.at(-1);
      const currentFatMass =
        rollingFatMass.at(-1);
      const currentMuscleMass =
        rollingMuscleMass.at(-1);

      const currentWeightElement =
        document.querySelector<HTMLElement>(
          "#current-weight"
        );
      const currentWeightMeta =
        document.querySelector<HTMLElement>(
          "#current-weight-meta"
        );
      const currentWeightTrend =
        document.querySelector<HTMLElement>(
          "#current-weight-trend"
        );

      const currentFatMassElement =
        document.querySelector<HTMLElement>(
          "#current-fat-mass"
        );
      const currentFatMassMeta =
        document.querySelector<HTMLElement>(
          "#current-fat-mass-meta"
        );
      const currentFatMassTrend =
        document.querySelector<HTMLElement>(
          "#current-fat-mass-trend"
        );

      const currentMuscleMassElement =
        document.querySelector<HTMLElement>(
          "#current-muscle-mass"
        );
      const currentMuscleMassMeta =
        document.querySelector<HTMLElement>(
          "#current-muscle-mass-meta"
        );
      const currentMuscleMassTrend =
        document.querySelector<HTMLElement>(
          "#current-muscle-mass-trend"
        );

      const currentWaist =
        document.querySelector<HTMLElement>(
          "#current-waist"
        );

      const currentWaistMeta =
        document.querySelector<HTMLElement>(
          "#current-waist-meta"
        );

      const currentFormIndex =
        document.querySelector<HTMLElement>(
          "#current-form-index"
        );

      const currentFormIndexMeta =
        document.querySelector<HTMLElement>(
          "#current-form-index-meta"
        );
      if (latestCircumference) {
        currentWaist.textContent =
          `${latestCircumference.waist_cm.toFixed(1)} cm`;

        currentWaistMeta.textContent =
          "Latest measurement";
      } else {
        currentWaist.textContent = "—";
        currentWaistMeta.textContent =
          "No data";
      }

      if (latestFormIndex) {
        currentFormIndex.textContent =
          latestFormIndex.value.toFixed(2);

        currentFormIndexMeta.textContent =
          "Latest measurement";
      } else {
        currentFormIndex.textContent = "—";
        currentFormIndexMeta.textContent =
          "No data";
      }

      const currentWaistTrend =
        document.querySelector<HTMLElement>(
          "#current-waist-trend"
        );

      const currentFormIndexTrend =
        document.querySelector<HTMLElement>(
          "#current-form-index-trend"
        );

      const circumferenceHistoryChart =
        document.querySelector<SVGSVGElement>(
          "#circumference-history-chart"
        );

      const inbodyLeanChart =
        document.querySelector<SVGSVGElement>(
          "#inbody-lean-chart"
        );

      const inbodyFatChart =
        document.querySelector<SVGSVGElement>(
          "#inbody-fat-chart"
        );

      if (
        !currentWeightElement ||
        !currentWeightMeta ||
        !currentWeightTrend ||
        !currentFatMassElement ||
        !currentFatMassMeta ||
        !currentFatMassTrend ||
        !currentMuscleMassElement ||
        !currentMuscleMassMeta ||
        !currentMuscleMassTrend ||
        !currentWaist ||
        !currentWaistMeta ||
        !currentFormIndex ||
        !currentFormIndexMeta ||
        !currentWaistTrend ||
        !currentFormIndexTrend ||
        !circumferenceHistoryChart ||
        !inbodyLeanChart ||
        !inbodyFatChart
      ) {
        throw new Error(
          "Current weight UI could not be initialized."
        );
      }

      renderCurrentMetric(
        currentWeight,
        weightTrend,
        currentWeightElement,
        currentWeightMeta,
        currentWeightTrend
      );

      renderCurrentMetric(
        currentFatMass,
        fatMassTrend,
        currentFatMassElement,
        currentFatMassMeta,
        currentFatMassTrend
      );

      renderCurrentMetric(
        currentMuscleMass,
        muscleMassTrend,
        currentMuscleMassElement,
        currentMuscleMassMeta,
        currentMuscleMassTrend
      );

      renderCircumferenceChart(
        circumferenceHistoryChart,
        waistHistory,
        formIndexHistory,
        historyStartDate
      );

      renderSegmentalLeanChart(
        inbodyLeanChart,
        segmentalData as SegmentalObservation[]
      );

      renderSegmentalFatChart(
        inbodyFatChart,
        segmentalData as SegmentalObservation[]
      );

      if (waistTrend) {
        renderTrend(
          waistTrend.slopePerWeek,
          currentWaistTrend,
          2,
          " cm"
        );
      } else {
        currentWaistTrend.textContent = "—";
      }

      if (formIndexTrend) {
        renderTrend(
          formIndexTrend.slopePerWeek,
          currentFormIndexTrend,
          3,
          ""
        );
      } else {
        currentFormIndexTrend.textContent = "—";
      }

      /*
       * Check write access only to decide whether the
       * "Add measurements" link should be visible.
       *
       * Failure here must not block read access.
       */

      const {
        data: canWrite,
        error: writeError,
      } = await canWriteDomain("body");

      if (!writeError && canWrite) {
        inputLink.hidden = false;
      }

      /*
       * IMPORTANT:
       *
       * Sick Bay data must only be loaded below this point,
       * after read access has been confirmed.
       *
       * No health-data queries yet.
       */
    }

    loginForm.addEventListener(
      "submit",
      async (event) => {
        event.preventDefault();

        const email =
          document.querySelector<HTMLInputElement>(
            "#email"
          )?.value;

        const password =
          document.querySelector<HTMLInputElement>(
            "#password"
          )?.value;

        if (!email || !password) {
          return;
        }

        authStatus.textContent =
          "Authenticating...";

        const { error } =
          await signIn(email, password);

        if (error) {
          authStatus.textContent =
            `Authentication failed: ${error.message}`;

          return;
        }

        await checkReadAccess();
      }
    );

    logoutButton.addEventListener(
      "click",
      async () => {
        authStatus.textContent =
          "Signing out...";

        const { error } =
          await signOut();

        if (error) {
          authStatus.textContent =
            `Sign out failed: ${error.message}`;

          return;
        }

        await checkReadAccess();
      }
    );

    await checkReadAccess();
  </script>
</BaseLayout>

<style>
  [hidden] {
    display: none !important;
  }

/* ------ Over all Sick Bay ------ */

  .sick-bay {
    width: min(100% - 2rem, 52rem);
    margin: 0 auto;
    padding: 1.5rem 0 4rem;
  }

  .sick-bay-header {
    margin-bottom: 2rem;
  }

  .sick-bay-header h1 {
    margin-bottom: 0.5rem;
  }

  .sick-bay-header__intro {
    margin: 0;

    color: var(--text-secondary);
    line-height: 1.6;
  }

  .sick-bay-section {
    margin-top: 3rem;
  }

  .sick-bay-section > h2 {
    margin: 0 0 1.5rem;

    font-size: 1.4rem;
    font-weight: 500;
    line-height: 1.2;
  }

/* ------ Current Metrics section ------ */

  .current-metrics {
    display: grid;
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  .current-metric {
    display: grid;
    gap: 0.2rem;
