---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Sick Bay">
  <main class="sick-bay">
    <header class="sick-bay-header">
      <h1>Sick Bay</h1>

      <p class="sick-bay-header__intro">
        Body composition and health trends.
      </p>
    </header>

    <div class="auth-status-row">
      <p
        id="auth-status"
        aria-live="polite"
      >
        Checking authentication...
      </p>

      <button
        id="logout-button"
        type="button"
        hidden
      >
        Log out
      </button>
    </div>

    <form
      id="login-form"
      hidden
    >
      <label>
        Email
        <input
          id="email"
          type="email"
          autocomplete="email"
          required
        />
      </label>

      <label>
        Password
        <input
          id="password"
          type="password"
          autocomplete="current-password"
          required
        />
      </label>

      <button type="submit">
        Log in
      </button>
    </form>

    <section
      id="sick-bay-content"
      hidden
    >
      <div class="sick-bay-tools">
        <a
          id="input-link"
          href="/sick-bay/input"
          hidden
        >
          Add measurements
        </a>
      </div>

      <section class="sick-bay-section">
        <h2>Current status</h2>

        <div class="current-metrics">
          <div class="current-metric">
            <p class="current-metric__label">
              Weight
            </p>

            <p
              id="current-weight"
              class="current-metric__value"
            >
              —
            </p>

            <p
              id="current-weight-meta"
              class="current-metric__meta"
            >
              7-day average
            </p>

            <div class="current-metric__trend">
              <p
                id="current-weight-trend"
                class="current-metric__trend-value"
              >
                —
              </p>

              <p class="current-metric__trend-label">
                12-week trend
              </p>
            </div>
          </div>

          <div class="current-metric">
            <p class="current-metric__label">
              Fat mass
            </p>

            <p
              id="current-fat-mass"
              class="current-metric__value"
            >
              —
            </p>

            <p
              id="current-fat-mass-meta"
              class="current-metric__meta"
            >
              7-day average
            </p>

            <div class="current-metric__trend">
              <p
                id="current-fat-mass-trend"
                class="current-metric__trend-value"
              >
                —
              </p>

              <p class="current-metric__trend-label">
                12-week trend
              </p>
            </div>
          </div>

          <div class="current-metric">
            <p class="current-metric__label">
              Muscle mass
            </p>

            <p
              id="current-muscle-mass"
              class="current-metric__value"
            >
              —
            </p>

            <p
              id="current-muscle-mass-meta"
              class="current-metric__meta"
            >
              7-day average
            </p>

            <div class="current-metric__trend">
              <p
                id="current-muscle-mass-trend"
                class="current-metric__trend-value"
              >
                —
              </p>

              <p class="current-metric__trend-label">
                12-week trend
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="sick-bay-section">
        <h2>History</h2>

        <div class="weight-history">
          <h3>Body composition</h3>

          <p class="weight-history__meta">
            Last 365 days
          </p>

          <div class="weight-history-chart">
            <svg
              id="weight-history-chart"
              viewBox="0 0 568 600"
              role="img"
              aria-label="Weight over the last 365 days"
            ></svg>
          </div>
        </div>
      </section>

    </section>
  </main>

  <script>
    import { supabase } from "../lib/sick-bay/supabase";

    import {
      getSession,
      signIn,
      signOut,
      canReadBody,
      canWriteBody,
    } from "../lib/sick-bay/auth";

    import {
      getRolling7DayAverage,
      getHistoryStartDate,
      getWeightTrend,
      renderBodyCompositionChart,
      type WeightObservation,
      type RollingAveragePoint,
      type WeightTrend,
    } from "../lib/sick-bay/body-composition";

    const loginForm =
      document.querySelector<HTMLFormElement>(
        "#login-form"
      );

    const authStatus =
      document.querySelector<HTMLParagraphElement>(
        "#auth-status"
      );

    const logoutButton =
      document.querySelector<HTMLButtonElement>(
        "#logout-button"
      );

    const sickBayContent =
      document.querySelector<HTMLElement>(
        "#sick-bay-content"
      );

    const inputLink =
      document.querySelector<HTMLAnchorElement>(
        "#input-link"
      );

    if (
      !loginForm ||
      !authStatus ||
      !logoutButton ||
      !sickBayContent ||
      !inputLink
    ) {
      throw new Error(
        "Sick Bay UI could not be initialized."
      );
    }

    async function checkReadAccess() {
      sickBayContent.hidden = true;
      inputLink.hidden = true;
      logoutButton.hidden = true;

      const {
        data: sessionData,
        error: sessionError,
      } = await getSession();

      if (sessionError) {
        authStatus.textContent =
          `Could not check authentication: ${sessionError.message}`;

        loginForm.hidden = false;
        return;
      }

      if (!sessionData.session) {
        authStatus.textContent =
          "Not authenticated.";

        loginForm.hidden = false;
        return;
      }

      loginForm.hidden = true;
      logoutButton.hidden = false; 

      const {
        data: canRead,
        error: readError,
      } = await canReadBody();

      if (readError) {
        authStatus.textContent =
          `Could not check read access: ${readError.message}`;

        return;
      }

      if (!canRead) {
        authStatus.textContent =
          "Authenticated, but you do not have access to Sick Bay.";

        return;
      }

      authStatus.textContent =
        "Authenticated · read access ✓";

      sickBayContent.hidden = false;

      const {
        data: weightData,
        error: weightError,
      } = await supabase
        .from("body_measurements")
        .select("measured_on, weight_kg, body_fat_pct, muscle_pct")
        .eq("source", "karada")
        .not("weight_kg", "is", null)
        .order("measured_on", { ascending: true });

      if (weightError) {
        authStatus.textContent =
          `Could not load weight data: ${weightError.message}`;

        return;
      }

      const fatMassData: WeightObservation[] =
        weightData.map((observation) => ({
          ...observation,
          weight_kg:
            observation.weight_kg *
            observation.body_fat_pct /
            100,
        }));

      const muscleMassData: WeightObservation[] =
        weightData.map((observation) => ({
          ...observation,
          weight_kg:
            observation.weight_kg *
            observation.muscle_pct /
            100,
        }));

      const rollingWeight =
        getRolling7DayAverage(weightData);

      const rollingFatMass =
        getRolling7DayAverage(fatMassData);

      const fatMassTrend =
        getWeightTrend(fatMassData);

      const rollingMuscleMass =
        getRolling7DayAverage(muscleMassData);

      const muscleMassTrend =
        getWeightTrend(muscleMassData);

      const historyStartDate =
        getHistoryStartDate(365);

      const weightHistory =
        weightData.filter(
          (observation) =>
            observation.measured_on >=
            historyStartDate
        );

      const rollingWeightHistory =
        rollingWeight.filter(
          (point) =>
            point.date >= historyStartDate
        );

      const muscleMassHistory =
        muscleMassData.filter(
          (observation) =>
            observation.measured_on >=
            historyStartDate
        );

      const rollingMuscleMassHistory =
        rollingMuscleMass.filter(
          (point) =>
            point.date >= historyStartDate
        );

      const fatMassHistory =
        fatMassData.filter(
          (observation) =>
            observation.measured_on >=
            historyStartDate
        );

      const rollingFatMassHistory =
        rollingFatMass.filter(
          (point) =>
            point.date >= historyStartDate
        );

      function renderCurrentMetric(
        point: RollingAveragePoint | undefined,
        trend: WeightTrend | null,
        valueElement: HTMLElement,
        metaElement: HTMLElement,
        trendElement: HTMLElement
      ) {
        if (
          !point ||
          point.mean === null
        ) {
          valueElement.textContent = "—";
          metaElement.textContent = "No recent data";
        } else {
          valueElement.textContent =
            `${point.mean.toFixed(1)} kg`;

          if (point.n >= 3) {
            metaElement.textContent =
              "7-day average";
          } else {
            metaElement.textContent =
              `7-day average · based on ${point.n} ` +
              `${point.n === 1 ? "measurement" : "measurements"}`;
          }
        }

        if (!trend) {
          trendElement.textContent = "—";
          return;
        }

        const slope =
          trend.slopeKgPerWeek;

        const direction =
          slope > 0
            ? "up"
            : slope < 0
              ? "down"
              : "flat";

        const sign =
          slope > 0
            ? "+"
            : "";

        const icon =
          direction === "up"
            ? `
              <svg
                class="trend-icon"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="m18 15-6-6-6 6" />
              </svg>
            `
            : direction === "down"
              ? `
                <svg
                  class="trend-icon"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              `
              : `
                <svg
                  class="trend-icon"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="M5 12h14" />
                </svg>
              `;

        trendElement.innerHTML =
          `${icon}<span>${sign}${slope.toFixed(2)} kg/week</span>`;
      }

      renderBodyCompositionChart(
        weightHistory,
        rollingWeightHistory,
        muscleMassHistory,
        rollingMuscleMassHistory,
        fatMassHistory,
        rollingFatMassHistory,
        historyStartDate
      );

      const weightTrend =
        getWeightTrend(weightData);

      const currentWeight =
        rollingWeight.at(-1);
      const currentFatMass =
        rollingFatMass.at(-1);
      const currentMuscleMass =
        rollingMuscleMass.at(-1);

      const currentWeightElement =
        document.querySelector<HTMLElement>(
          "#current-weight"
        );
      const currentWeightMeta =
        document.querySelector<HTMLElement>(
          "#current-weight-meta"
        );
      const currentWeightTrend =
        document.querySelector<HTMLElement>(
          "#current-weight-trend"
        );

      const currentFatMassElement =
        document.querySelector<HTMLElement>(
          "#current-fat-mass"
        );
      const currentFatMassMeta =
        document.querySelector<HTMLElement>(
          "#current-fat-mass-meta"
        );
      const currentFatMassTrend =
        document.querySelector<HTMLElement>(
          "#current-fat-mass-trend"
        );

      const currentMuscleMassElement =
        document.querySelector<HTMLElement>(
          "#current-muscle-mass"
        );
      const currentMuscleMassMeta =
        document.querySelector<HTMLElement>(
          "#current-muscle-mass-meta"
        );
      const currentMuscleMassTrend =
        document.querySelector<HTMLElement>(
          "#current-muscle-mass-trend"
        );

      if (
        !currentWeightElement ||
        !currentWeightMeta ||
        !currentWeightTrend ||
        !currentFatMassElement ||
        !currentFatMassMeta ||
        !currentFatMassTrend ||
        !currentMuscleMassElement ||
        !currentMuscleMassMeta ||
        !currentMuscleMassTrend
      ) {
        throw new Error(
          "Current weight UI could not be initialized."
        );
      }

      renderCurrentMetric(
        currentWeight,
        weightTrend,
        currentWeightElement,
        currentWeightMeta,
        currentWeightTrend
      );

      renderCurrentMetric(
        currentFatMass,
        fatMassTrend,
        currentFatMassElement,
        currentFatMassMeta,
        currentFatMassTrend
      );

      renderCurrentMetric(
        currentMuscleMass,
        muscleMassTrend,
        currentMuscleMassElement,
        currentMuscleMassMeta,
        currentMuscleMassTrend
      );

      /*
       * Check write access only to decide whether the
       * "Add measurements" link should be visible.
       *
       * Failure here must not block read access.
       */

      const {
        data: canWrite,
        error: writeError,
      } = await canWriteBody();

      if (!writeError && canWrite) {
        inputLink.hidden = false;
      }

      /*
       * IMPORTANT:
       *
       * Sick Bay data must only be loaded below this point,
       * after read access has been confirmed.
       *
       * No health-data queries yet.
       */
    }

    loginForm.addEventListener(
      "submit",
      async (event) => {
        event.preventDefault();

        const email =
          document.querySelector<HTMLInputElement>(
            "#email"
          )?.value;

        const password =
          document.querySelector<HTMLInputElement>(
            "#password"
          )?.value;

        if (!email || !password) {
          return;
        }

        authStatus.textContent =
          "Authenticating...";

        const { error } =
          await signIn(email, password);

        if (error) {
          authStatus.textContent =
            `Authentication failed: ${error.message}`;

          return;
        }

        await checkReadAccess();
      }
    );

    logoutButton.addEventListener(
      "click",
      async () => {
        authStatus.textContent =
          "Signing out...";

        const { error } =
          await signOut();

        if (error) {
          authStatus.textContent =
            `Sign out failed: ${error.message}`;

          return;
        }

        await checkReadAccess();
      }
    );

    await checkReadAccess();
  </script>
</BaseLayout>

<style>
  [hidden] {
    display: none !important;
  }

  .sick-bay {
    width: min(100% - 2rem, 52rem);
    margin: 0 auto;
    padding: 1.5rem 0 4rem;
  }

  .sick-bay-header {
    margin-bottom: 2rem;
  }

  .sick-bay-header h1 {
    margin-bottom: 0.5rem;
  }

  .sick-bay-header__intro {
    margin: 0;

    color: var(--text-secondary);
    line-height: 1.6;
  }

  .sick-bay-section {
    margin-top: 3rem;
  }

  .sick-bay-section > h2 {
    margin: 0 0 1.5rem;

    font-size: 1.4rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .current-metrics {
    display: grid;
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  .current-metric {
    display: grid;
    gap: 0.2rem;
  }

  .current-metric__label {
    margin: 0;

    color: var(--text-secondary);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .current-metric__value {
    margin: 0;

    color: var(--text-primary);
    font-size: 2rem;
    font-weight: 500;
    line-height: 1.1;
  }

  .current-metric__meta {
    margin: 0.2rem 0 0;

    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .current-metric__trend {
    margin-top: 0.9rem;
  }

  .current-metric__trend-value {
    display: flex;
    align-items: center;
    gap: 0.3rem;

    margin: 0;

    color: var(--text-primary);
    font-size: 1rem;
    font-weight: 500;
  }

  .current-metric__trend-value :global(.trend-icon) {
    width: 0.9rem;
    height: 0.9rem;

    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;

    opacity: 0.7;
  }

  .current-metric__trend-label {
    margin: 0.15rem 0 0;

    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .weight-history {
    margin-top: 1rem;
  }

  .weight-history h3 {
    margin: 0;

    font-size: 1rem;
    font-weight: 500;
  }

  .weight-history__meta {
    margin: 0.25rem 0 0;

    color: var(--text-meta);
    font-size: 0.8rem;
  }

  .weight-history-chart {
    width: min(100%, 46rem);
    margin: 1.5rem auto 0;
  }

  .weight-history-chart svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .weight-history-chart :global(.composition-panel-title) {
    fill: var(--text-secondary);
    font-size: 10px;
    font-weight: 600;
  }

  .weight-history-chart :global(.weight-trend-window) {
    fill: var(--green-surface);
    opacity: 0.5;
  }

  .weight-history-chart :global(.weight-axis) {
    stroke: var(--line-default);
    stroke-width: 1;
  }

  .weight-history-chart :global(.weight-grid-line) {
    stroke: var(--line-subtle);
    stroke-width: 1;
  }

  .weight-history-chart :global(.weight-month-line) {
    stroke: var(--green-surface);
    stroke-width: 1;
  }

  .weight-history-chart :global(.weight-axis-label) {
    fill: var(--text-muted);
    font-size: 11px;
  }

  .weight-history-chart :global(.weight-y-tick) {
    text-anchor: end;
    dominant-baseline: middle;
  }

  .weight-history-chart :global(.weight-x-tick) {
    text-anchor: middle;
  }

  .weight-history-chart :global(.weight-axis-title) {
    fill: var(--text-muted);
    font-size: 11px;
    text-anchor: middle;
  }

  .weight-history-chart :global(.weight-raw-point) {
    fill: var(--chart-data);
    opacity: 0.22;
  }

  .weight-history-chart :global(.weight-rolling-line) {
    fill: none;
    stroke: var(--chart-data);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .weight-history-chart :global(.weight-chart-meta) {
    fill: var(--text-muted);
    font-size: 10px;
    dominant-baseline: middle;
  }

  .weight-history-chart :global(.weight-legend-line) {
    stroke: var(--chart-data);
    stroke-width: 2.5;
    stroke-linecap: round;
  }

  .weight-history-chart :global(.weight-trend-label) {
    fill: var(--text-meta);
  }

  .weight-history-chart :global(.composition-panel-label-bg) {
    fill: var(--page-background);
    opacity: 0.7;
  }

  .weight-history-chart :global(.composition-hover-line) {
    stroke: var(--text-muted);
    stroke-width: 1;
    stroke-dasharray: 2 3;

    pointer-events: none;
  }

  .weight-history-chart :global(.composition-hover-tooltip) {
    pointer-events: none;

    fill: var(--text-primary);
  }

  .weight-history-chart :global(.composition-hover-tooltip-bg) {
    fill: var(--page-background);
    stroke: var(--line-default);
    stroke-width: 1;
  }

  .weight-history-chart :global(.composition-hover-tooltip-date) {
    font-weight: 600;
  }

  #auth-status {
    margin: 0.5rem 0 1.75rem;

    color: var(--text-muted);
    font-size: 0.85rem;
  }

  #login-form {
    display: grid;
    gap: 1rem;

    width: min(100%, 24rem);
  }

  #login-form label {
    display: grid;
    gap: 0.35rem;

    font-size: 0.9rem;
    font-weight: 500;
  }

  #login-form input {
    width: 100%;
    box-sizing: border-box;
    padding: 0.8rem 0.9rem;

    font: inherit;
    font-size: 16px;

    color: var(--text-primary);
    background: var(--surface-neutral);
    border: 1px solid var(--line-default);
    border-radius: 0.35rem;
  }

  #login-form input:focus {
    outline: 2px solid var(--line-green);
    outline-offset: 2px;
  }

  #login-form button {
    justify-self: end;

    padding: 0.75rem 1rem;

    font: inherit;
    font-weight: 500;

    color: var(--text-primary);
    background: var(--green-surface);
    border: 1px solid var(--line-green);
    border-radius: 0.35rem;

    cursor: pointer;
  }

  .auth-status-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;

    margin-bottom: 1.75rem;
  }

  .auth-status-row #auth-status {
    margin: 0;

    color: var(--text-muted);
    font-size: 0.85rem;
  }

  #logout-button {
    padding: 0;

    font: inherit;
    font-size: 0.85rem;

    color: var(--text-muted);
    background: none;
    border: 0;

    cursor: pointer;
  }

  #logout-button:hover {
    color: var(--text-primary);
  }

  .sick-bay-tools {
    display: flex;
    justify-content: flex-end;

    margin-bottom: 2rem;
  }

  .sick-bay-tools a {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .sick-bay-placeholder {
    margin: 3rem 0;

    color: var(--text-muted);
    font-size: 0.9rem;
  }

  @media (max-width: 640px) {
    .current-metrics {
      gap: 1rem;
    }

    .current-metric__value {
      font-size: 1.7rem;
    }

    .current-metric__trend-value {
      font-size: 0.9rem;
    }
  }
</style>
