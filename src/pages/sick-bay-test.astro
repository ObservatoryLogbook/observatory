---
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Sick Bay Test | Observatory</title>
  </head>

  <body>
    <main>
      <h1>Sick Bay — Supabase Test</h1>

      <form id="login-form">
        <label>
          Email
          <input id="email" type="email" required />
        </label>

        <label>
          Password
          <input id="password" type="password" required />
        </label>

        <button type="submit">Log in</button>
      </form>

      <p id="status">Not authenticated.</p>

      <section id="measurement" hidden>
        <h2>Latest body measurement</h2>

        <dl>
          <dt>Measured</dt>
          <dd id="measured-on"></dd>

          <dt>Weight</dt>
          <dd id="weight"></dd>

          <dt>Body fat</dt>
          <dd id="body-fat"></dd>

          <dt>Muscle</dt>
          <dd id="muscle"></dd>

          <dt>Source</dt>
          <dd id="source"></dd>
        </dl>
      </section>

    <hr />

    <section id="body-entry" hidden>
      <h2>Add body measurement</h2>

      <form id="body-form">
        <label>
          Date
          <input
            id="body-date"
            type="date"
            required
          />
        </label>

        <label>
          Weight (kg)
          <input
            id="body-weight"
            type="number"
            step="0.1"
            inputmode="decimal"
            required
          />
        </label>

        <label>
          Body fat (%)
          <input
            id="body-fat-input"
            type="number"
            step="0.1"
            inputmode="decimal"
            required
          />
        </label>

        <label>
          Muscle (%)
          <input
            id="body-muscle-input"
            type="number"
            step="0.1"
            inputmode="decimal"
            required
          />
        </label>

        <button type="submit">
          Save measurement
        </button>
      </form>

      <p id="body-entry-status"></p>
    </section>


    </main>

    <script>
      import { createClient } from "@supabase/supabase-js";

      const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
      const supabaseKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY;

      const supabase = createClient(supabaseUrl, supabaseKey);

      const form = document.querySelector<HTMLFormElement>("#login-form");
      const status = document.querySelector<HTMLParagraphElement>("#status");
      const measurement =
        document.querySelector<HTMLElement>("#measurement");

      if (!form || !status || !measurement) {
        throw new Error("Sick Bay test UI could not be initialized.");
      }

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        const email =
          document.querySelector<HTMLInputElement>("#email")?.value;
        const password =
          document.querySelector<HTMLInputElement>("#password")?.value;

        if (!email || !password) return;

        status.textContent = "Authenticating…";
        measurement.hidden = true;

        const { error: authError } =
          await supabase.auth.signInWithPassword({
            email,
            password,
          });

        if (authError) {
          status.textContent = `Authentication failed: ${authError.message}`;
          return;
        }

        status.textContent = "Authenticated ✓";

        const bodyEntry =
          document.querySelector<HTMLElement>("#body-entry");

        if (bodyEntry) {
          bodyEntry.hidden = false;
        }

        const { data, error: dataError } = await supabase
          .from("body_measurements")
          .select("*")
          .order("measured_on", { ascending: false })
          .limit(1)
          .single();

        if (dataError) {
          status.textContent =
            `Authenticated, but data retrieval failed: ${dataError.message}`;
          return;
        }

        document.querySelector("#measured-on")!.textContent =
          data.measured_on;
        document.querySelector("#weight")!.textContent =
          `${data.weight_kg} kg`;
        document.querySelector("#body-fat")!.textContent =
          `${data.body_fat_pct} %`;
        document.querySelector("#muscle")!.textContent =
          `${data.muscle_pct} %`;
        document.querySelector("#source")!.textContent =
          data.source;

        measurement.hidden = false;
      });


      const bodyForm =
        document.querySelector<HTMLFormElement>("#body-form");

      const bodyEntryStatus =
        document.querySelector<HTMLParagraphElement>("#body-entry-status");

      bodyForm?.addEventListener("submit", async (event) => {
        event.preventDefault();

        if (!bodyEntryStatus) return;

        const measuredOn =
          document.querySelector<HTMLInputElement>("#body-date")?.value;

        const weight =
          document.querySelector<HTMLInputElement>("#body-weight")?.value;

        const bodyFat =
          document.querySelector<HTMLInputElement>("#body-fat-input")?.value;

        const muscle =
          document.querySelector<HTMLInputElement>("#body-muscle-input")?.value;

        if (!measuredOn || !weight || !bodyFat || !muscle) {
          bodyEntryStatus.textContent = "Please complete all fields.";
          return;
        }

        bodyEntryStatus.textContent = "Saving...";

        const { data, error } = await supabase
          .from("body_measurements")
          .insert({
            measured_on: measuredOn,
            source: "karada",
            weight_kg: Number(weight),
            body_fat_pct: Number(bodyFat),
            muscle_pct: Number(muscle),
          })
          .select()
          .single();

        if (error) {
          bodyEntryStatus.textContent =
            `Save failed: ${error.message}`;
          return;
        }

        bodyEntryStatus.textContent =
          `Saved measurement for ${data.measured_on}.`;

        bodyForm.reset();
      });
    </script>
  </body>
</html>