---
import "../styles/global.css";
import Telescope from "@lucide/astro/icons/telescope";

interface Props {
    title?: string;
}

const {
    title = "Observatory"
} = Astro.props;

const pageTitle =
    title === "Observatory"
        ? "Observatory"
        : `Observatory · ${title}`;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width"
        />
        <link
            rel="icon"
            type="image/svg+xml"
            href="/favicon.svg"
        />
        <meta
            name="description"
            content="A personal collection of observations, projects, and data."
        />
        <title>{pageTitle}</title>
    </head>

    <body>
        <header class="site-header">
            <nav class="site-nav" aria-label="Main navigation">
                <a href="/" class="site-brand">
                    <Telescope class="site-brand__icon" aria-hidden="true" />
                    <span>Observatory</span>
                </a>
                <a href="/logbook/">Logbook</a>
                <a href="/about/">About</a>
            </nav>
        </header>

        <slot />
    </body>
</html>